{
  "schemaVersion": 1,
  "locale": "zh-CN",
  "sourceLocale": "en",
  "enabled": false,
  "provider": "openai-compatible",
  "model": "gpt-5-mini",
  "baseUrl": "https://api.openai.com/v1",
  "apiKeyEnv": "OPENAI_API_KEY",
  "temperature": 0.2,
  "batchSize": 60,
  "concurrency": 4,
  "timeoutMs": 180000,
  "reviewPasses": 1,
  "preserveTerms": ["AI Hero", "Matt Pocock", "Claude Code", "Codex", "Cursor", "Copilot", "GitHub", "TypeScript", "Next.js", "LLM", "MCP", "TDD"],
  "style": "准确、自然、简洁的简体中文技术内容。保留命令、代码、路径、产品名和品牌名。"
}
