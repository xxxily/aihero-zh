      "text": "Up next · lesson",
      "hash": "7915dcb8d2117c7a6a8fa6d5a1901ad5fa87b609352be8aca042d9a52d097c78"
    },
    {
      "id": "56ac3bccb83dae39075aaa9d7edf464d3f6ce978da1027a2bb8df1f234f54375",
