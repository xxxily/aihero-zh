    },
    {
      "id": "77fc7345bc7bf82f8ba43e39e8db296b8f852249bcb4bfa39e6f8a97c80ed705",
      "text": "Free 7-day email course",
      "hash": "6aba8f3e1e4c9c030dec098b6093e55d5187ac3c649a6337daf5e86d47f008aa"
    },
    {
      "id": "8c086a6076d8a76e68c98becc3a0c101f5968c4589a883aaa189f8dd8a19901f",
      "text": "AI Skills for Real Engineers",
      "hash": "8080f99f294dba13aacef7c83da5b81be9e5fc7576a838d3a6c6e2786d1035b5"
    },
    {
      "id": "cf55851a328119c743f2b4da150bffee46d9de3c7cd121dbfc5fd02c8b1fba62",
      "text": "Build a repeatable workflow for working with coding agents without giving up your engineering standards.",
      "hash": "fcb15182653f1ed6d314a1ca67020539e5466faa84503e40d1f5a683f9b5a5f0"
    },
    {
      "id": "f3229dd11bf3d2954b26d03db064a4da9dc7a0e33acc6335a13d7c6d652f1eea",
      "text": "One practical lesson each day. Learn the skill, try it on real work, and finish the week with a workflow you can reuse.",
      "hash": "3a1af14aef302b9430126b35e35665d5b6ef890617f677f057ac6b1b4c2495a8"
    },
    {
      "id": "20935fcaca2edbb91c1b31cab08202da0dd78647ee64449569c17af234052d64",
      "text": "Lessons",
      "hash": "cb4ad503e340ebd1a921e3ed6dcbfc0a80660936d8bfc9d190f70694b9ccb51b"
    },
    {
      "id": "6bb6c377648c24c5d2fea44b8321ff9beeed966484a5bc49397bf151de1a728f",
      "text": "Developers subscribed",
      "hash": "2a3c9789b4d3a312ca335d875c2a3f86fa1c67dd5da26d67391551c9dabe8843"
    },
    {
      "id": "a8d2a1f15a4dfb0239ef974e35638609c3dd204afc2ec217fbc76f3bc10de154",
      "text": "No account needed",
      "hash": "1ad20e017d7621688b9c96059912ca850c58414909b509092d31aa294d548718"
    },
    {
      "id": "2ce73cf92dbb504c120ed95bb6bd57bbd19f8cb98ed7acdd45602ac9b5da54d0",
      "text": "Free",
      "hash": "f411a1fb62758b4c54690d0a702b4955b54dd22115416fa7b1ce51b4a084818d"
    },
    {
      "id": "b3db70f9fa55ad9f09ab44d834f4e7273340dc4b551f6faf0a708fd34adf1ca9",
      "text": "Start the course",
      "hash": "a602723d450ce6f804f4e4701bdedb71962574673aaebf9afa509e1deb15cdfa"
    },
    {
      "id": "182631567f86bf9bdcf2bd5cbd0ab412d0f7c32ac36f031c55251660b4193fad",
      "text": "Get lesson one in your inbox",
      "hash": "19b98eb2ede90017867db84e46550598f465664f6f775dd9d4446c2dfcfc1020"
    },
    {
      "id": "df0f7f8d1857c71ace31a9b292329769dff003458f44e8a7ea52a0eef9a3cfed",
      "text": "First Name",
      "hash": "96ce6e6193a047260f5c32aa416d88b6e8959111f43f98457af9cc009a0907ad"
    },
    {
      "id": "eecd046a17f103745de5565212d4cd1e47a6ae10f80c91434a32e878d98eb928",
      "text": "Email*",
      "hash": "61dff02026341a6e553a56fc2ba214a76ad68c18cc67bf732993cfdbd51bb8b4"
    },
    {
      "id": "887c84f00ab9971646d7c940124bcfc95e1a03954effbfa7f7c663eaa805246f",
      "text": "Start the free course",
      "hash": "9ac2404ad07155af43c1327c5014b1de20ec489948bb3e2075b3c6389ff981a0"
    },
    {
      "id": "1c966662be4b4d72e03c259bb705fb9fa8e95171bcc39fb15d785a246c00a1a4",
      "text": "I respect your privacy. Unsubscribe any time.",
      "hash": "c429347d1095e2bdaf56f7ae06e3249840e3134a7a02f1793142f7a4da8e60c0"
    },
    {
      "id": "987951dd67d2e035c9a30d9b6acff6a63ffa821212ec99d32754e8e455a57f67",
      "text": "From fuzzy idea to a workflow you trust",
      "hash": "5403510e6bdf5a275fc43966b328826e9bee9092381cd78f1c7045f7377f04fc"
    },
    {
      "id": "2ef441b93879db72709d22da55e6016f87ecf2ae3f82a23cddc57c3ae97c787b",
      "text": "Each day is one skill and one small exercise on work you already have. Nothing here is theory you can't run the same afternoon.",
      "hash": "14845f3ea2a82e3a7e078bbe57b868d388a0a7b65f4603a2bf42bd1df370d693"
    },
    {
      "id": "5cac042a606476c42be7fcd5dff0307630282aaf7643c9898e320188798cec09",
      "text": "Day",
      "hash": "8f2364e11b8be3ff008f32b3dedb54e659362429bcc9e3eb6acb6070de4ffbff"
    },
    {
      "id": "b60eb41abc1ce4a048f9414563c1ece8d57f38291d3b528099d798cade2e92d1",
      "text": "Choose your workflow path",
      "hash": "55561dfa5fd263b9e94069be897dffdc85c809bf01acff5c8cf1e13a8a30c73e"
    },
    {
      "id": "d9a750d71b8107378f90e6d32a176e0b91eb46e88e0c160e682bba42a449ed1d",
      "text": "Start with reusable agent workflows instead of one-off prompts.",
      "hash": "af89edb22d1dcd7c7bcebd8a75a5983604901a7eae13d55c4fd881d0af548fbf"
    },
    {
      "id": "3752aab36d0ee081c00da09e519ee1354fce298d3020bcf49af93543edfff0bb",
      "text": "Clarify the work with",
      "hash": "11f58e71b3e485f8f450f3babfed1f5a355140d6972ed118c7010cb3c43cb8b9"
    },
    {
      "id": "66a071b569171056e66d47ed61af227c5b5a2dff252d1e9a67ea5ae462b797c4",
      "text": "Find the fuzzy decisions before an agent starts building.",
      "hash": "8722132e0cec68f50556bef9b8284c60c5ec97d23154e62aad336e4255c9d36f"
    },
    {
      "id": "8d41d1e06a3982c0e2128788b828427d429f497c4c26b2d882a0f1f9902f3124",
      "text": "Test uncertain ideas with",
      "hash": "57eeebf0a5bb6f5a535a79effd00e5a38be673ccf7853ff469a894b4f67d8115"
    },
    {
      "id": "355943fcffc991da413c167bf141c30bf14d9039cbb3d6d1eb19ea47fece3d24",
      "text": "Make the unknown visible in a small, throwaway context.",
      "hash": "b91e6aeae30bf5326f7b459ed761667d2894b94be0bf4374d8caa121f061d63d"
    },
    {
      "id": "dd8801ecb5acac6fa389ba54d5d83065a5f36a5faac9ab3906178d138f011306",
      "text": "Turn decisions into",
      "hash": "53e2f71d67528be2f0ab314f8ad86ea76f8f594dd6704b003c7efdf45756a076"
    },
    {
      "id": "776e5ddf6189e9b0b28b7756581bd86fd8a954fec0dd4072e22d0d881c1cdebc",
      "text": "Break large work into reviewable vertical slices.",
      "hash": "6c5d9c4983b6234f5e66d20b94c20a57fa8e5af25216fb88b8baf7edee6c42b2"
    },
    {
      "id": "8be8980775ced32a434477c29260efd353ce931270283eb6de9245d910e5dfaf",
      "text": "Run safer AFK agents with Sandcastle",
      "hash": "05ce4885459de0edb25a47b3d08c4cd3050dffe27afba3fdf6357d56f3417846"
    },
    {
      "id": "f3a27868de849caaf31985bd7340ea9f30b10ed3b2a3e50a615e222cf6024ec7",
      "text": "Scoped tasks, isolation, visible logs, and reviewable commits.",
      "hash": "2d0cc41817df25ce532dcff4a21b40d626e3f93b0b3c4b102772c066160abca0"
    },
    {
      "id": "33387867b363c1b22e911bfe07d49b944ebca86a180e74445151c7b4062f3b15",
      "text": "Review the result with",
      "hash": "ec29b5df0a387428a46f7389390c7e707487747f6b6bd56c09e9390c9c53d7b2"
    },
    {
      "id": "c590739e6ce295b7ace08cd34432338bd7047fd2ea3325271852d059abba088c",
      "text": "Find avoidable mistakes and improve the system around the diff.",
      "hash": "bda65ae59ddaec4fa258901f415afdd080187cfbc26deb6829efc99bc1420618"
    },
    {
      "id": "75caed4a4000bee9c7bb571e734ae0ba81f6644fbc089c68114028bc6a6c2f34",
      "text": "Put the full workflow together",
      "hash": "744e33f369bdaf3b15263fd09c7fb4ecf2819a5e2ab47ac9d437f5888b291350"
    },
    {
      "id": "0dd3087aa13377342a56cb74a03fb3319b4e5900d8bdd7ff2b6d1ed0f716b44b",
      "text": "Run the loop from fuzzy idea to a better next agent run.",
      "hash": "c2d6095a37170489592b686b33f73634dc6d4c2f8c4f30d903ec580cad9fd0f6"
    },
    {
      "id": "c317d4dbb247aba2ca3d8fd7c1f1c9493e272d45618affa9d413e7751b4af308",
      "text": "Day 7, what you'll have",
      "hash": "73fa45efa56fedad96b5a372e455926cd91baf42c5aecd181ddb057d7219c246"
    },
    {
      "id": "a3113b3c4b83667a69cb771d492a36d170ccaf5a91aae2506f0b4d22941d34f2",
      "text": "One written workflow, the slash commands that run it, and a review habit that keeps your codebase one an agent still performs well in.",
      "hash": "d096b3ddb946d3289d0da1a314ef280d026b5eab982bcd2055e47d6f8fa5b2a0"
    },
    {
      "id": "9c8fda01def50e8b724b984ac0c6dcd75e8cefd6169233bfd275f55f2d4fbe18",
