      "hash": "4def77f9388809f53620144510fcc4b6f08662617bcc06a15abc618242e6544c"
    },
    {
      "id": "90c763abad923475d489fcec246bb03d206461ca56f35ca76dce40645318e9d3",
      "text": "Topics",
      "hash": "e22820fcf5cd90e3fdd99a7569e0ee2f30eb7ebadfb2fe4d159b30c166ff81b7"
    },
    {
      "id": "86970356deef17e0c6f0ad5228f43004ed931ec904a6c655fab9a2f502e4739a",
      "text": "Memory and Steering",
      "hash": "e9396c915a0fb1c9f188708920573d4a5b1ec0a09639049682989999ecbdf3de"
    },
    {
      "id": "06359d69c19593321739dc56b6709ede1ecfde98b344755081479cd37cdf9dc2",
      "text": "Progressive disclosure",
      "hash": "cc1b70611c98675e8e42c8d6246c2f13f869540b48c6abd18713bd25ecc7611b"
    },
    {
      "id": "64974a0dba49f833e6cc1390276fc8ee1fad369e804203d8b7b50ee52ff31eee",
      "text": "Loading only the context an agent needs right now, with context pointers to the rest. Borrowed from UI design.",
      "hash": "6d2b614348e39cae34b13b50817334d59406fe772318327ad72a8174d9eb7e38"
    },
    {
      "id": "f3ee53a6d4809b5ce95ac9f3103925422f3e8953e325db7cd0f7b853b62faf7e",
      "text": "Matt Pocock",
      "hash": "2fe2c13509fbd45ec2578a74ef8efda313caad4f19533a102ca7d666ed60881d"
    },
    {
      "id": "7d124ac6c1b0069c0f61c21844c5f758d7d67b1d01d25242351d8921fc97e4ee",
      "text": "Copy page",
      "hash": "4104018941ae3ab016c117887a91b4f933f28e36c587b8983373fe9377ce34d7"
    },
    {
      "id": "898775fbba3d33316cc4bf3880ca690f977b78ac7360351d228bc594bd2a38f5",
      "text": "Loading only the",
      "hash": "07eea9cfcba26c5888af74211f8370cc434a8a37e74bb6e77a8e747b10dd38cb"
    },
    {
      "id": "0c435a2500c87ddcbbd737fdbe56c3f746be3df3aae409545f7640c287dbbd16",
      "text": "needs right now, with",
      "hash": "2441130aac53fec1f7ad8018e3c120e8b467ab8d3fa8c49282eb034fb0c03e78"
    },
    {
      "id": "6a82fdd6ca604bfb7d6930888ff5f3aa18a1e9b4376dd47d2874b5e7abcd3965",
      "text": "context pointers",
      "hash": "82528bbf7c9c348f2db59980c707a48c7c85c4ea3d7f7f63f107a209445930c8"
    },
    {
      "id": "f1121c5eda33152bf100775250f9b623c5ec8869ec2d9c1178ac40d4621a8cb3",
      "text": "to the rest. Borrowed from UI design, where it means showing users only the controls relevant to their current task and hiding the rest behind a click.",
      "hash": "f60d2f6edff66ef3b7019e6680ce26ff567da10a61755739cacd7f678cbbdbae"
    },
    {
      "id": "92f2f3a660acc20d7f3341b5fd13bba9e6771269430d388a13d72b14d575281f",
      "text": "The technique exists because context is a cost twice over. Every",
      "hash": "dc0a32922f377edbca2d90f7d7f0ac29be5f52a51397c5e1095bf299b10975fb"
    },
    {
      "id": "5c63b348e402b4cdf5b501d64989db96d9d42a188fad52156316c2ec61a82cac",
      "text": "loaded up front is billed as",
      "hash": "5f77ceaa04ddf08d636bd82627e4bc021cd9d60ff730d6d1b6162a6a71bea2d2"
    },
    {
      "id": "7b43cb1589985194805fa65047e1635e518c9a0cded4802d3427922ee4742a49",
      "text": "input tokens",
      "hash": "f0c1cb4cda1985a408b12908c01227b01065a8cdfc2a03e2106ca60275f27d16"
    },
    {
      "id": "66598cc797b9e2c902d112856b0c98fb2ed5865429cc9bbd369025c1bb6f91ee",
      "text": "on every",
      "hash": "9c34ac1fbff22cab4932baa69eb90745f947cf422eff5ee836621fb87edec310"
    },
    {
      "id": "3198f8096542d9fa4718761babbc55eea6dc941fbcb2892f866922377c7c1ba8",
      "text": ", and every token spends",
      "hash": "08c2bc0e10b42157840fd24865436b989f173a6440f55d1dc8ae5610c9f4354a"
    },
    {
      "id": "33f40888184419014bb326e840744f28905ae67de2409932db93c3a5b167c8f9",
      "text": "attention budget",
      "hash": "4f0ecd6ea97f18771cbd4203a929018449d8dbd4c6cce6f90fd7511b5c34cc81"
    },
    {
      "id": "b520e3fc1c9a0e534de73e8e9c34179628287b268455748d94e4aa836bdf7a9e",
      "text": "whether the agent needs it or not. An",
      "hash": "d1f158f9166577e6fcfbaf847f7e0b00b162ae5c3c67df82092b640da2c26c0a"
    },
    {
      "id": "b0bcdf07d6ae529de66e0d5cb02206e41b19215ee8df29e063eb6f86e01d9b55",
      "text": "stuffed with the full style guide, deployment runbook, and database conventions makes the agent worse at all of them — the instructions that matter for the current task are diluted by the ones that don't. The tell is an agent that ignores rules you know are in its context: they're in there, but buried.",
      "hash": "191b3c2e1850874f53c6a78b0fc483ffdfefcde3faddf466f6ccc232cf1a07ad"
    },
    {
      "id": "5cbb33a4f23f3e5e67eaa01155d203c43915551ba8b2f35a50e475d261810d43",
      "text": "Progressive disclosure inverts this. Keep the always-loaded layer small — a sentence per topic and a pointer to where the detail lives. The agent reads the style guide when it's writing a component, the deployment runbook when it's deploying, and neither when it's fixing a test.",
      "hash": "c4c63341d8c627ff0e5786326db8198d7dde1b6abd977fc2c6f617afddbc73f8"
    },
    {
      "id": "f7045336026e50e8588ceb696c44977edac3275fb7ca59a4db5b4a2a20817ad9",
      "text": "are the pattern built into the",
      "hash": "7778deda0fae04c10785318e1451450d5c656524c13395a5866d2478f5ff21d0"
    },
    {
      "id": "099195426485e767676074976aff98f1d6b2168ec7d640208f41151dcfc5720f",
      "text": ": a short description loaded every",
      "hash": "112a571baf8384ceb0fb4d89e465b39607fa56560acab0f9d22cee60edb66e57"
    },
    {
      "id": "3bda4fba03a6ffcfe3cc7e355a752ab9374ab0a328480c33f548906148ed88bf",
      "text": ", the full instructions only when triggered.",
      "hash": "3ab815315808519936b23b1406d31a9c0efce9c592eb520495a0ea2135aab051"
    },
    {
      "id": "b4a152d3408d4c3e2a228eae82e8498be8cb3e91413f831fde5e06b80f64c109",
      "text": "Usage:",
      "hash": "2bad3eeaf33caffe3bc9b482b4934ed19eb4ec3614c12373e1a5c5f8948217da"
    },
    {
      "id": "ad44520368ba76a13a72d7e94ac50ce401b89d3cc4552b1e1d67c9950fd44708",
      "text": "\"Should I dump the entire style guide into AGENTS.md?\"",
      "hash": "a7c5131c7f731904446d9e121f0b6be59fca1c93d8f70c984f0caddfdc90e4ec"
    },
    {
      "id": "89b4d0e3ab3fa5176c2da37aa4f19322269ec3c11df76e65e7285e7b5491ccb9",
      "text": "\"No — progressive disclosure. Reference the style guide as a skill the agent loads when it actually needs to write a component. AGENTS.md pays the token cost every turn.\"",
      "hash": "feb855f61c13d4fbd35a8325bd16f6607603a4d8e24e60008a0a025f80516eba"
    },
    {
      "id": "17bd401ed3ac3b5c8e6f3ebbcbc136764a5540b2c57dd981c116935603f9381b",
      "text": "Previous term",
      "hash": "735604aff9e8f2192b83df4905cfc8e395613e0ce05f8ca85a1d2d1d44fd59f3"
    },
    {
      "id": "c355642e1122af0b1eb34f37ac706d7a060f39748f37ff26db08a4b58b38cbd3",
      "text": "Next term",
      "hash": "5219c7ebdc0e098aa6db6f09e405c1b17ab75f1082862906a872e10a16818f9e"
    },
    {
      "id": "f8e712ac14ab02b55fa3531d3135652b102f0f9aa01a4947ee9fff8c4b5c1907",
      "text": "Context pointer",
      "hash": "d95bc371d100339c0ab85461467e2c00939ce2b4d26a5c74d8a927ccfab4b271"
    },
    {
      "id": "4c3197229b850b3ab45adc7d4052202205326a44dccfab96c9df392f815be12c",
      "text": "Want more than vocabulary?",
      "hash": "5d5500a083006a1606e84a03c018904d01364631c6baea4c7a3f8f3f62bf94dc"
    },
    {
      "id": "1e3bfbc80db522a6212611ba89ef4d3567bb0dccc5fb97c5e270a376b73d1c11",
      "text": "Join AI Hero for practical skills, thinking on AI engineering, and resources that keep you ahead of the curve.",
      "hash": "a082f7147e30da6afe92268d5668a530edfff13e64934f8f63f22c098db86133"
    },
    {
      "id": "835fc3abe4bc00d75c6c9b989ecc93ca61ab66ca82f398a7d225a395419a8cb4",
      "text": "First Name",
      "hash": "96ce6e6193a047260f5c32aa416d88b6e8959111f43f98457af9cc009a0907ad"
    },
    {
      "id": "2edade70ff734bd4d7b7841f059a34d20d7c7a8e95803cef9dd1a0f5fa857fa4",
