    },
    {
      "id": "e6160ca52f2c5333387e59f1cd22ac378b006e2a5e2dee46b85c75f25adb441f",
      "text": "Handoffs",
      "hash": "29f217d5d86062d687fceaed0f8ff7da2900d2b2b33d409e4abfd6ebe310c1b4"
    },
    {
      "id": "44a5f03efd2f2e671ba6d303df057b5ec3defe5ea74d607b67dc3fc5df9f64e0",
      "text": "Compaction",
      "hash": "a0ade140bc8e408639e51492b949bc4d31641625ef070015b5d4a5e92ef0edb0"
    },
    {
      "id": "fca155aecabf6c07a9723d70bd28c613329d75baeedc741cfb4bbe24060da24d",
      "text": "A handoff done in-memory: the previous session's history is summarised and seeds a fresh session. Lossy — detail traded for headroom.",
      "hash": "7d9a1548a9ad3d41558cb7553a4c42b1044c4f09262ed9257957ed929a83de69"
    },
    {
      "id": "d37e0731007ab546b8b52c08f752a78a344b94bce7069fd87e5146fd6293e42c",
      "text": "Matt Pocock",
      "hash": "2fe2c13509fbd45ec2578a74ef8efda313caad4f19533a102ca7d666ed60881d"
    },
    {
      "id": "46a8bb9c5a03f474075c60cf0fdf084b7772a630ff10bee94691a35b611045aa",
      "text": "Copy page",
      "hash": "4104018941ae3ab016c117887a91b4f933f28e36c587b8983373fe9377ce34d7"
    },
    {
      "id": "2da55bf5be19d62bf21c86139e8c0d5cf4e225a7df8d94ed2bffc71fa5f6ca82",
      "text": "done in-memory: the previous",
      "hash": "5b58b0eade145cea29ecc2bf479c2081b22b3dd8a14922d23796de8a94ca4854"
    },
    {
      "id": "609dbf9096fcd98c44b7a4182caf432f6d5628132fd1650cd4de04cbc200b6cb",
      "text": "'s history is summarised, and the summary seeds a fresh session. Lossy by design: the transcript is a",
      "hash": "b31436b3cf26fdd6e8dd141d2446093b1f53097067d1631d1b7f8d851169126d"
    },
    {
      "id": "d355a5eb94c2c8553107a84f4f5364a3037d883fadcb2d22622fc376801bc1b2",
      "text": "primary source",
      "hash": "4c3f03bb625194b79deeff56ee12d13258ff531de6eef1fff5529d0fe89a1404"
    },
    {
      "id": "05db63f8e474999975c6271366d2fabe6dc97bd4d2448fb4d8cd50f6a8f1687d",
      "text": ", the summary a",
      "hash": "5852cc7382261ea6b275c86356fb1fba7701f60a018acbb36ab5ecbf3cdb541c"
    },
    {
      "id": "db220017ad23d76a1b89bfe04ab90c44ba64163913262221d5aa9bdb0c96f0d2",
      "text": "secondary source",
      "hash": "130ab3f910dec4f94436851c6b9a50abec9e6cb96e7aadf7c47be2e57da1c894"
    },
    {
      "id": "29f2e286d6acb3a1a5eb195991da600828bc53e335a49410d082388e2a0e1f9f",
      "text": "— detail traded for headroom. Triggered manually by the user, or automatically via",
      "hash": "fac551e66f65d0643e7eb7b18a4d0ebb269c79c8746b66b043cb83a41ad08f0d"
    },
    {
      "id": "412d014e24a90c0bdcdecdf4719031e40b8a86172a1264889790f9762fb45f74",
      "text": "The mechanism: the",
      "hash": "849707092dcd4901b8c9373a16d370c6a786c57fb30b6681542cdecaadebc430"
    },
    {
      "id": "1f4645225f0a8de56f9ca5c03e71dc4d1ade3477ef2b93acaa64a221b70abd16",
      "text": "context window",
      "hash": "6764434518d37f01df452fe2af0af3f314f8c27a72519001ea14189c5ee42476"
    },
    {
      "id": "cb6b4df983aebd9e0de7a80a451a6074e9db98e75c452625c1af92d0f490ed15",
      "text": "is finite, and a long session fills it — every",
      "hash": "41cde6f7591be7c44d3a10a0fbc614becbde77c3a328ebac3b8279011fed81c5"
    },
    {
      "id": "aae13cc574527b07ef9ebc5642a3d5f3fb96d59598a093c7f960e10fe80a2c8e",
      "text": "tool result",
      "hash": "496514e28de40f2624fbc4fb01c89afaba32fde82d1e1d6c19ab43d702f7a230"
    },
    {
      "id": "5690d63f433f5c0b540befea6ecd3ee0e51472a5a10d766e73c2a691a14d4eae",
      "text": ", every file read, every wrong turn stays in history. When it gets heavy, the",
      "hash": "7d877dac82a4aceff620d2529005eea1053e4f2b2a18615d551b2753a1b6839d"
    },
    {
      "id": "86d388eae83737b2e97858942767734b5688cb8d79476dc3c0f1f565ff8f933d",
      "text": "asks the",
      "hash": "b6ad410cf93b478a44667ddfb46b496f46fbc085988ca8f5fbd4d979304d85b5"
    },
    {
      "id": "c915973a550e70042aae0b3a610da565b2802a74d6b9330272e431942cd4a0c1",
      "text": "to summarise the session, throws the original history away, and seeds a fresh session with the summary. Whatever didn't make it into the summary is gone from the context. Some harnesses soften this by keeping the old transcript on disk and leaving a",
      "hash": "c919b46a1c9e4d5fa8ba7af54f09354d410fea9d6136683d036e678bc48aff15"
    },
    {
      "id": "bd18862a6e082da274e98251fe7fd498b49fc4bd328f77baabd51dcfe3df83bf",
      "text": "context pointer",
      "hash": "7fb80893d92cf9accaa94f3b2f011e80e1ed58eb0ec3e161e07b14e34c36ca1b"
    },
    {
      "id": "b4b45a61dd2e3575b90c1cc5bb5a1f64f3a774d9cc22a3b7a527d50b0ea5e208",
      "text": "to it in the summary — the secondary source links back to its primary source, so a detail the summary lost can be recovered by re-reading the original.",
      "hash": "bfa8d0421fc521d99bb35a253996ceb050c067cd054d6e12774e9c5dcfe1e865"
    },
    {
      "id": "359a85132f68727ee46035b97c58255f96608d5c9efe01925e874bf2f4b48624",
      "text": "The summary is written by the model, so it can be prompted. \"Preserve the schema decisions\" makes the generated artifact more deliberate. Timing matters too — compact at a phase boundary, after the plan is settled, not mid-task.",
      "hash": "810cbbb38c1d2824f16660e044782d83f919c47ca07ddc5ecf200484fadd583d"
    },
    {
      "id": "8f20418ad7edf21b22b53e5d7f1ed590dedb0816dbde131baf9aebfee4bc7d6d",
      "text": "Contrast with",
      "hash": "19e678afd9694ad52d8189ca9004dbf8acf98ed1e41fa478c7afd2ee8fe2fdcd"
    },
    {
      "id": "342ab280a07cabee2ee4c48e9ac26136b4e31cd8e9b789374ef9356b361a8659",
      "text": ", which drops everything and starts cold: compaction tries to carry the essentials across; clearing bets they're already written down somewhere better.",
      "hash": "6194575d9ae0318d66f530f4aaef5ae1a878b6751c5e35b6a9324c770a42b8a0"
    },
    {
      "id": "fe2fe5078c6b3bbef6149a06cf1b11d445badbfaba1750a254f238305aa09a71",
      "text": "Usage:",
      "hash": "2bad3eeaf33caffe3bc9b482b4934ed19eb4ec3614c12373e1a5c5f8948217da"
    },
    {
      "id": "3fcb14937e53c9edbd8b5f312026fdc62f8aab5828b9c44a902f8840a4d5eecc",
      "text": "Context",
      "hash": "a6e600a10fede40f648be37a700467776215ed2da3c271e9d02fa2987190a0a0"
    },
    {
      "id": "3dde515216736e434678d55a4a12c61dc41f4ba68736c53e85690467a5f96244",
      "text": "'s getting heavy and I still have the test pass to do.\"",
      "hash": "8f96ce51b292f447d6a368689485d53cd77bbd0b7cafbd69e4bf5fc8f3c1e980"
    },
    {
      "id": "57c5d12fa538da564b34f10e1da84072e40779816ee00a3c73b4b2fa09a5242d",
      "text": "\"Compact before you start — write what must survive into the summary prompt so the new session keeps the schema decisions and drops the exploration.\"",
      "hash": "39921d14f87e164862fb73f0061dbf9de478aa53f9403dcab0b70099d3abb97f"
    },
    {
      "id": "4386b0dc3afa6e8e298a42e975358fdf5a389680ecc77196b3504930acf53eb4",
      "text": "Previous term",
      "hash": "735604aff9e8f2192b83df4905cfc8e395613e0ce05f8ca85a1d2d1d44fd59f3"
    },
    {
      "id": "95d76b5eb19e9f8e2467355c89d46c20b1ab752e00034749dcb375eb2256db52",
      "text": "Ticket",
      "hash": "567a8b5f8f5ce3c525286711a68555da645ab87e929439f5badba2507fd2b6eb"
    },
    {
      "id": "97297c34e118b9cf0221b25219517ca2af7a308b53f8321e0a40a9ba4ec8fe1b",
      "text": "Next term",
      "hash": "5219c7ebdc0e098aa6db6f09e405c1b17ab75f1082862906a872e10a16818f9e"
    },
    {
      "id": "0b0db167f04cae3b54959bac987e6b0f0ec0bad3d37f8bf20cacfee293e1176c",
      "text": "Autocompact",
      "hash": "8a36ad552d898798dd978db0b1b2d4e568ae7f3c3b3295eedb4df69ab8604e0d"
    },
    {
      "id": "aae0390b0f95c6ca5458b3fcf32d338a6a17e4501c97c9888525a098b588446c",
      "text": "Want more than vocabulary?",
      "hash": "5d5500a083006a1606e84a03c018904d01364631c6baea4c7a3f8f3f62bf94dc"
    },
    {
      "id": "d63d2cee2b2b04eb3997a6bb53023dec8f3dc482c7beb9e57ae0aa27f8bf9ad2",
      "text": "Join AI Hero for practical skills, thinking on AI engineering, and resources that keep you ahead of the curve.",
      "hash": "a082f7147e30da6afe92268d5668a530edfff13e64934f8f63f22c098db86133"
    },
