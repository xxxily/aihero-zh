      "hash": "bece2dfa71670e0dba50ef01a35087b4bfd34004db429177a1d484837dc5ee9d"
    },
    {
      "id": "44f9c2535d4ec8ffcfd15dc8967d2bd4e8219cef74b78d94799cea53bdf7c0ef",
      "text": "Learn how to block dangerous git commands in Claude Code using a PreToolUse hook. Prevent accidental data loss with git guardrails.",
