    },
    {
      "id": "0007cccfab87936e36b8f29307a18d38946ee5bf3004b23d5e8aa197dba37f81",
      "text": "Topics",
      "hash": "e22820fcf5cd90e3fdd99a7569e0ee2f30eb7ebadfb2fe4d159b30c166ff81b7"
    },
    {
      "id": "aed236079a4d742066062fb19677e2ac1350275a77fdabc097c2515e4b014437",
      "text": "Tools & Environment",
      "hash": "cf9194302814cf2bb2ae04f0e1023fec3d18acdc5258a0e00c18bb7df366cf00"
    },
    {
      "id": "4160ace03946033c4e2e89e124d9de6a58354ca54ca735c4dae32721bb33836c",
      "text": "Environment",
      "hash": "9e471951a1b4106e54be128a21112b02914fe98cc79b2c92b49ee80c5464487c"
    },
    {
      "id": "363d1a83c8c959f9794c3a102bb47c94ad152e3b16e16785fb57b3720fb260cb",
      "text": "The world the agent acts on — anything outside the harness that the agent perceives via tool results and changes via tool calls.",
      "hash": "86fbad51fa7bd74f5c6ac338e5a5f2e0527e4a3d67592026300fa7f9c1ba539c"
    },
    {
      "id": "1cbd41fc2352a83656842aaa05fecdee574c2c27f69b44b17849e68ae67d802b",
      "text": "Matt Pocock",
      "hash": "2fe2c13509fbd45ec2578a74ef8efda313caad4f19533a102ca7d666ed60881d"
    },
    {
      "id": "f98e687a4e3819334e1bd34bca91db38fb73d8ef53a114b7b3564415bd097302",
      "text": "Copy page",
      "hash": "4104018941ae3ab016c117887a91b4f933f28e36c587b8983373fe9377ce34d7"
    },
    {
      "id": "30e33711a91f9cf41e2f200555fd625e7135927233ec7c6ba7b72d857cc00d8c",
      "text": "The world the",
      "hash": "0e8883051219352197f88734e6c01758bc773dba9184fc400977290a37cb9b8b"
    },
    {
      "id": "f12c3f591a4d2511ad0427708dc6f816734800c559ed8ca911098d94e7e3bf50",
      "text": "acts on — anything outside the",
      "hash": "003d439089cc4ed56ac500feac24a3a54d1add6c30327d14ff6d859bd3282c5f"
    },
    {
      "id": "3b0bde817ae12d05c551580a3778075a61c47b78952aff9409d6aae7680d51cc",
      "text": "that the agent perceives through",
      "hash": "8e337c2804b50abbefbbd5ff98c7a2b3cfa438e5df59a777541bc8e5b219ff74"
    },
    {
      "id": "204ccf5345e574e9e73be7a84e4c0cca7b18733f98a75b54af6ecb13c9ff88a3",
      "text": "tool results",
      "hash": "a5594e12dfffd8e54c36d9b99bc31c7d41f0389d2251790338f34e836a3211fe"
    },
    {
      "id": "2093c7f40f9ab7573dc202209b4e7158fbaebcc77491102156f5eb8867f4372b",
      "text": "and changes through",
      "hash": "a0b9e033d5dfc3c747eb3c00de20be6df2ce4ca2d67fc0924964f3f24c8030f0"
    },
    {
      "id": "3d9ab93776dda65460830ed9ec49fad26821ef3c785a0fec197b5715f7d337a6",
      "text": "tool calls",
      "hash": "b102cdc6032df9ca67169a6d620fba86a9b0344b8dab71565a5b230deadb5e68"
    },
    {
      "id": "14a4010538686f7b46b54f041af92860f26806c58dfadcb8a6472ecb7497421b",
      "text": ". The harness",
      "hash": "2a7bbee929118b537566c3ff3192d1c38fbcd5f838e7070b2d95ad626769813a"
    },
    {
      "id": "23cc4d57c0754c302bfa8fb3834c0f1f5088be763be04ce329b771a12bc5ef32",
      "text": "the agent; the environment is what the agent",
      "hash": "06c7f04d535cfa1627e428b11e59d64104f6f480209efc5aa0f34dfedab1425b"
    },
    {
      "id": "727516f71911e826e33cfcfa1b66f9e012e0e67d74597adf08cad7cbf2bd0709",
      "text": "works in",
      "hash": "ebf2cc38bbe90308fd18783bc38b4d01020978a1004f4f53e8cf309590a32d17"
    },
    {
      "id": "d3c3cf8d6526136da2ebd05f9a2b002ffb60b12b9d415ec2e0fd8f2b3d5c0777",
      "text": ". A file like",
      "hash": "20b2a1c26acf6abda2ba74da524b74332fc6e928c6a58eb5729663191f11d930"
    },
    {
      "id": "5ce1ab9ef542b9bfa1d16a133649b04fb136043baaf97cbc6c6cf0750d7d7137",
      "text": "lives in the environment; the harness is what loads it into the",
      "hash": "3a501604ed0ab5d695893e08b9276ae6cc15f367834b8cc4554ea11884698a7d"
    },
    {
      "id": "a15ac24e65b9a05d967b0e4ddc42902cc85843ba5898afb08e9e3615ccf41171",
      "text": "context window",
      "hash": "6764434518d37f01df452fe2af0af3f314f8c27a72519001ea14189c5ee42476"
    },
    {
      "id": "2be9b5fe7bf9256b020c6217190368180bc3c3c600863a5dfb644810b1926b2d",
      "text": ". A",
      "hash": "ad1eadeb773a0b806593938abbf1d7190868ea0b0b5da7496f9eb0d6758d6ac4"
    },
    {
      "id": "654286c1bee69299d5f2e3dd0f064362a432749f273899c3c23e47800aea08ab",
      "text": "is the most common kind of environment, but not the only one (a database, a remote API, a browser session can all be environments).",
      "hash": "63689c212df969aa59b99854f2c3c88d90a8eebe49173fae62b2a706b7e67a18"
    },
    {
      "id": "aca7461805e0e43654e9a8b70ccc9655f29c26058f3d9159e8aeaff65d88b577",
      "text": "The agent only sees the environment when it looks. Everything it knows about the environment arrived through a tool result, so its picture is a collection of snapshots, each accurate at the moment it was taken. If a file changes after the agent read it — you edit it by hand, a build step regenerates it — the agent keeps reasoning from the stale copy until something prompts a re-read. An agent confidently describing a file that no longer looks like that is usually this: the environment moved, the snapshot didn't.",
      "hash": "3c78defe5da72bab0045d4d333221ebde257f968b92b84bf78b02f1dd90fe942"
    },
    {
      "id": "0e3a30911117bd557c46c66a5f39beaf3f2a0ec6d8b3289bac83be60a4dee322",
      "text": "The environment is also the layer that persists — the only one that is always",
      "hash": "8543cf8f53958ed5db80db24d2e5b214bf0be15ef575fe9bf01447eb78abfe64"
    },
    {
      "id": "5438b4c5d94075acb0a3bf77402cd3ee14c9012dfb43bbab202ffb35630714fe",
      "text": "'s context is gone when the session ends, but files written to the environment remain for the next session to read — which is what",
      "hash": "cb368dd2dc1c87310e08151e75b6db2279d9db3a981ac0919eecf8aae0d8df42"
    },
    {
      "id": "e36e68d28d0718c9a14e455ea9abaf00ccc46732e55aa6efc5387ef9333a731a",
      "text": "memory systems",
      "hash": "8699aeec0f58f0cf15c1e661971b31bf6a9663656c19f558ef1a1450599d15ce"
    },
    {
      "id": "abdea1ae4802b8c21dbc0b623b5f1c43d32274d510c1cb4209c0db5ce2d8cf2d",
      "text": "handoff artifacts",
      "hash": "78a3516549d7b8e8a934563d52ab8e83d5f2048f1c372864042ed720577ba58b"
    },
    {
      "id": "607918871e3ca7a9e3787686c84178c4d6e962027b5ae1d78346fb0569569e9a",
      "text": ", and",
      "hash": "4aa9bfd2f175a94ad5a7cb321e1aea9790c73eb366a3415b47a00aeaa9fbf24a"
    },
    {
      "id": "548cdfbd0faa9b0891e3ade6ba0bd8ebc4693e5ec786c634d3637944b31fd4d5",
      "text": "rely on. Anything an agent should still know tomorrow has to end up in the environment.",
      "hash": "fa1c8bcdacdf428235bb1a8402a024a9528468298866e8a3321cd3d1f10d13b7"
    },
    {
      "id": "b2911303da698445a4015b63bd81343ea236864ca70f7412866a3a5f90e2c9e7",
      "text": "You decide how big the environment is. A",
      "hash": "e1b690e05b12212538344c49070ab274fa1ec3b36b04a933d7f3334482d61865"
    },
    {
      "id": "402d449051c0c0b03dad594042decc01bb3e7bba1a8387865ba240844c87452f",
      "text": "shrinks it, limiting what the agent can reach; adding a",
      "hash": "268446faf72e0ff5c457a0b83fe8e0b8e2d04bd5003b20c9642e370615c59a53"
    },
    {
      "id": "235a73aa345f0e159d22662731c652702163ab43835f3ba79f78ed08f3759cc4",
      "text": "extends it, bringing a database or an API into reach. What's inside the boundary is what the agent can perceive and change; everything outside it doesn't exist for the agent. How well the environment is set up to support the agent's work is the codebase's",
      "hash": "38319710b684f29b8d99ad8d71505829fe639f682b714b49be27a69cf176b936"
    },
    {
      "id": "b138424b8ced49f90eb5ee9d0fc368a5996890adb4bed97e5f46a0ad18b23337",
      "text": "AX",
      "hash": "bbe96fa9f44ea0fcf38b0ec729822f37f5cc11e625753b2a250a90a3b59dd098"
    },
    {
      "id": "dd4f0f4cfd45c6271981ba96127f0a051fa7abe9b30275c2c80e596f00718d22",
      "text": "Avoid:",
      "hash": "0c98d3dd1920fdb71269240ba1ce3a7323099760ecd0b295f071aca6b07e30df"
    },
    {
      "id": "9a8099b6c56fcff5d62755796709ba35bbac365ff5d4ed90c386c7450391b97b",
      "text": "using \"environment\" for the runtime or the harness itself — the harness is the wrapper, the environment is the workspace.",
      "hash": "bc266b375d56ffe338826e9cb2a858cda896cfc89bb61646185423ab5f3d482b"
    },
    {
      "id": "15a776cc55a9220f3aba85d623073e8bde8424e015a31df9d9daba2ed2bb5287",
      "text": "Usage:",
      "hash": "2bad3eeaf33caffe3bc9b482b4934ed19eb4ec3614c12373e1a5c5f8948217da"
    },
    {
      "id": "a65ca06fdac739f2561957771f7f4fe29b01cb9eaaa9aaa8baf85e0705ee4cee",
      "text": "\"The agent can't see the staging DB schema.\"",
      "hash": "c544852f9baa5240b29ecbeab1212b4bcad9abb4f94337192748ceb1a6bd3005"
    },
    {
      "id": "5d2c4cef583a522bbaf094547e22faf3f6c55729b170af9eccdc7758028c8ede",
      "text": "\"Wire it into the environment — give it a",
      "hash": "767a06a24bc9c808037fe38b504bf4e8dcadd77a6edd57333f52e45e05eb5f79"
    },
    {
      "id": "bb4dc115aeeab4fba5a9532c0e57dcb480ef8491bd9480f9668933e3f297b289",
      "text": "tool scoped to read-only on staging. The harness is fine, it just has nothing to act on.\"",
      "hash": "dd0d0f43a054c9e924e35eb192b1559065c9e216212b61f931d1e07d4eab1083"
    },
    {
      "id": "d9b725a707e6066ac55184ccdacce25c1aa332479223f6c40616535d5f0cb293",
      "text": "Previous term",
      "hash": "735604aff9e8f2192b83df4905cfc8e395613e0ce05f8ca85a1d2d1d44fd59f3"
    },
    {
      "id": "4d2300a7a80bdf9c526957595d4100a3d12af4711c02c2b1395117965f264bb3",
      "text": "Turn",
      "hash": "b823d5f9d1ce690c00935e097200405bcf903b6bbd61e4866c3c1fda7fb3238c"
    },
    {
      "id": "cf250b06f54b0aee6294c4924b819d63df261fa52cf1e13c1fa083d55ee5d025",
      "text": "Next term",
      "hash": "5219c7ebdc0e098aa6db6f09e405c1b17ab75f1082862906a872e10a16818f9e"
    },
    {
      "id": "1408e1672c129863bea6418585b00b71001823eefe33f07186bd277f50bd8609",
      "text": "Filesystem",
      "hash": "8230c68a6158c8ba8c1b7d5b8e0557be9564e129e15806f60dc2205a9ca5bfe7"
    },
    {
      "id": "31160a884829cd19cffb51db0a15878593a90976fe56806f4db61f4321065015",
      "text": "Want more than vocabulary?",
      "hash": "5d5500a083006a1606e84a03c018904d01364631c6baea4c7a3f8f3f62bf94dc"
    },
    {
      "id": "763808ef43f327365edad3b783c7ca11ee4b4c4a6e32d4290e30db993b5f42f7",
      "text": "Join AI Hero for practical skills, thinking on AI engineering, and resources that keep you ahead of the curve.",
      "hash": "a082f7147e30da6afe92268d5668a530edfff13e64934f8f63f22c098db86133"
    },
    {
      "id": "e9a00bb167a6abc52302188ec0c4b3affc13eb0f994425eace1749da6353ca4f",
      "text": "First Name",
      "hash": "96ce6e6193a047260f5c32aa416d88b6e8959111f43f98457af9cc009a0907ad"
    },
    {
      "id": "122fecf55bdde51b95a3d1a1c30009dec47b3b2795303e42b7320da30cb4c05c",
      "text": "Email*",
      "hash": "61dff02026341a6e553a56fc2ba214a76ad68c18cc67bf732993cfdbd51bb8b4"
    },
    {
      "id": "87c791c88604c4df327cf9a32bcfbd9fa2e71e0c04085398d1a8e73f3cd40ff4",
      "text": "Get AI Hero updates",
      "hash": "81b46eab414c141d6dcd85a5bd534179bf54a3532469436d693c437e9de3a90a"
    },
    {
      "id": "599ce746bb096ee5a9ab81704c168ae50448457d91ebb672d558d67b6e7950bf",
      "text": "No spam. Unsubscribe anytime.",
      "hash": "461f8758206b36fd4ddfaf6740b33dc0de41c9c7acb9121525993b781d5e18bb"
    },
    {
      "id": "d742a441505b07679935835fee686ff9bff2917eeac25693bb6e64f5c8137c33",
      "text": "Share",
      "hash": "29887a5ff9846ccc23327565a07e17fa6dcaea6211f1898ae825f84ae38f4223"
    },
    {
      "id": "ccab24b5ac97a497655ff1f9a19ce0f82fb024252a4923c5be3491ae010bf514",
      "text": "Copy URL",
      "hash": "b26d1037f1c2da31a0296d915982f12049f91bfedb998b105ce967b73a796699"
    },
    {
      "id": "53447cacb688fe82ebf05a09a990ce5814046d0956d13be8c0b71da6510ffaaf",
      "text": "Learn",
      "hash": "ce78afd0e6a225ecac96a6812b9d192e7eb35889cd5237beb38b50375b79d8dd"
    },
    {
      "id": "e9ac4fed19846a5790c8f6b03108b8b3de1c7585a0e4695ce0d7170af749edec",
      "text": "AI SDK v6 Crash Course",
      "hash": "71139c58dab0fc6fcc2f49d2d44fd5b7c9e9e6e7fbf043ec2f4b51758b1b82b1"
    },
    {
      "id": "94d5a1880df3ad12f7dcff6a81e78fc93c910f17b787ef08f592307c6646f3f6",
      "text": "The AI Engineer Roadmap",
      "hash": "0ecca41f97662f50fc4210f00b4d05ed73257d862ecbd642b906cd7da42d4092"
    },
    {
      "id": "b0f5d4d2dbf6a53d239c0c50c8aac99658a80765b35c9aa0db9b2c2a0bbb8ee1",
      "text": "Vercel AI SDK Tutorial",
      "hash": "2f2904108d573c969e5838280a3b2a087d103fdf0b462b1707035a6d6da2d62c"
    },
    {
      "id": "0a12bd7ed9697d94247457e3afcdd9b1a3d1bfc2e72ba0e44462ef77bf788700",
      "text": "Model Context Protocol Tutorial",
      "hash": "d52bb57113ca725e4597402d041c46eaea7dad7dd40c1f6c374b03c1576d396e"
    },
    {
      "id": "0fde75f1e7b0d0e21a2bc87b71c47f9125caf07b2ef36bd3aca6d26bee06ae29",
      "text": "Cohorts",
      "hash": "e777d5967e8cd7d5430cf77dddcd2c67e54c6cdd955e18f1b7923733d09bff49"
    },
    {
