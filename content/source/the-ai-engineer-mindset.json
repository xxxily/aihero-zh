      "hash": "e22820fcf5cd90e3fdd99a7569e0ee2f30eb7ebadfb2fe4d159b30c166ff81b7"
    },
    {
      "id": "af1354c3cde3aff994ea2cb1492d3ea2baed408ef14687b05651d6756fdf2ad5",
      "text": "05 / 07",
      "hash": "0d046abc933ab3955825a922905e8f880d6402ad4d2ddcf49cd5fa12134363c6"
    },
    {
      "id": "f6e387837a5741e42ebcaabb261b4c4737fe0f497c47afc7611b526d215e6d6e",
      "text": "The AI Engineer Roadmap · 5 min read",
      "hash": "ed8b6afc3a374a307751070f43525360a8b6d4f0912515a26c70cdfb2a099105"
    },
    {
      "id": "432fef251dbb4b0d3a8fea9f85b7baee49ed2ecce66f947c90c499b06ddc71ac",
      "text": "Learn how to build successful LLM applications by defining clear success metrics, and creating a data-driven culture of continuous improvement.",
      "hash": "02ecdd3a3757c036153f2cee64b1e2607642a9a7191df28163c403e926d02735"
    },
    {
      "id": "803f5e929c8ef1edb2fac61db449e8cab6e6ca9203c765c7a89d052e0bbc2368",
      "text": "Matt Pocock",
      "hash": "2fe2c13509fbd45ec2578a74ef8efda313caad4f19533a102ca7d666ed60881d"
    },
    {
      "id": "57292e88cc6d3f828dd036a0f31a02faaf66c320bd68547fd1aed6f24e5a3312",
      "text": "Subscribe",
      "hash": "cc0e38da9c41790bffef1b88af32d39ac285edce93da766810edc237cb2f1625"
    },
