    },
    {
      "id": "7406bbab9b36066becf301ce0b4ae5b9805afa36d2c71473d1bf0f85e8eebc84",
      "text": "The AI Engineer Mindset",
      "hash": "4cecfc761ad682ecad4c15da33f30edeeae171b6fae7e9b2473d35315877d59e"
    },
    {
      "id": "42ad135746570b89aa5bc0158f78a63477d5af3182f8dbbd43dc548d684561ce",
      "text": "Your App Is Only As Good As Its Evals",
      "hash": "273e8085c3620f4e390bb0daf43c57d11f9220ec626c119820da3c453d7840f9"
    },
    {
      "id": "29a131c4fa1cbe362201113779927289234d5dc9f867cb4c9320c33c07bfeb10",
