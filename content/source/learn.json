    {
      "id": "de63f26381a57e1cf5e5d9c8d4081e841715115b8a6d133ddfb4ddc89138f4ec",
      "text": "Not sure where to start?",
      "hash": "ebe2c8cc1ee9fbeef55f74efd208a54b77e184251a9ecd5c8986effccbf014e3"
    },
    {
      "id": "86b871552657831b1edc0000af396962b9f9081f68f33b68fe107c831c90cbda",
      "text": "Ask the bot. It knows every article, video and skill on the site.",
