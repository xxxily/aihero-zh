    },
    {
      "id": "c41fc5a5c9b93781c35c1ef4acd2346922eb184d298e2b87ce0c610468dfb62e",
      "text": "Topics",
      "hash": "e22820fcf5cd90e3fdd99a7569e0ee2f30eb7ebadfb2fe4d159b30c166ff81b7"
    },
    {
      "id": "afee12a3a0cec2f31940628652cf23035cb9d1395f2270451d0d33894878f63d",
      "text": "Handoffs",
      "hash": "29f217d5d86062d687fceaed0f8ff7da2900d2b2b33d409e4abfd6ebe310c1b4"
    },
    {
      "id": "9b365ec609e521f8d4bd3aa2df52ef079fe5a9a89a29b3e4832564ac50f0c6fc",
      "text": "Handoff",
      "hash": "f89e2d72da00888b27c938fff1eff1d138fd49fb664d0269527a69e746ced479"
    },
    {
      "id": "f465599e6fb72d1217d2149340d63732309b337660b1dcfddc54cdef536771de",
      "text": "Transferring agent context from one session to another, with no return path. Carry mechanism varies — artifact, compaction, others.",
      "hash": "afa7316d1164640fd935599a2ed85edc3c30891e73ed40922e8297bfeb67a101"
    },
    {
      "id": "7b0854f3a0152fa3b3fd68faaa441b0441560a24d55605f8714729572efd6e69",
      "text": "Matt Pocock",
      "hash": "2fe2c13509fbd45ec2578a74ef8efda313caad4f19533a102ca7d666ed60881d"
    },
    {
      "id": "82d68153e601391426c5338be29db4b5aa15538ab16ac7333f2913d898f9d204",
      "text": "Copy page",
      "hash": "4104018941ae3ab016c117887a91b4f933f28e36c587b8983373fe9377ce34d7"
    },
    {
      "id": "827a4d9f632be72383f410e8c12aee22d7a361685b959dddc2235d3e5119391e",
      "text": "Transferring",
      "hash": "5e16e20d6e130f916eb84197c8b5c4cb5c3040cd7d9a51a9c26a29937c079fad"
    },
    {
      "id": "558b356485a6495fb652f562364efe6c915244bac9d6e9dbcb9f39806db22609",
      "text": "from one",
      "hash": "e9450cbf4b7a387eea887dcc850564d6974ef364c8afdb7537abe1a088211af4"
    },
    {
      "id": "ac390ce4fbbb66eb6d5cc0223cdf800b9f2e1c4cc0e3ccf8f032734973bf1052",
      "text": "to another. The carry mechanism varies — a written",
      "hash": "90104b8ae837d6cc2ceb288d4c062767173a32a6079b8106f0746c7bc213de7a"
    },
    {
      "id": "6c24ca34e621af18cb6aa85ec724902646e823e932d974aec113487d25424373",
      "text": "handoff artifact",
      "hash": "741619a26b388b5e1035994e6e7ce6c59c885ebd231ad21f8d9ff02438a0cbc9"
    },
    {
      "id": "a8029ee163e3bfec7b9b1895890f5f517a8db4108b0371b992403aaff37d8002",
      "text": ", an in-memory summary (",
      "hash": "56db31abaa4c3a3c5b26287978985d99dfa4c073a9b50ad50dac64772e8ca888"
    },
    {
      "id": "13835d1c171022ed7286fad417f48b189667251141a15a071f1192a04e433d58",
      "text": "), and others. Distinct from",
      "hash": "1e7d47d79d8995940f1cc1007bb01f4d6255f91a32c38f90ef927c99d6cd0924"
    },
    {
      "id": "ca45cd2ba5e0d9dd5c9618ab7eae829d07d2dda2660ac4d457cde35f7b9c3ff4",
      "text": "(no transfer at all). Reasons vary: switching roles (planner → implementer), kicking off an",
      "hash": "84f20f5894993319c96f8eb3f19eaad9ec6cd1ab6e137b9fc57337247e916d01"
    },
    {
      "id": "fde7eaa921bd16944ad4496f047a441a88f4bfdef93df8323df61e85f3933f04",
      "text": "AFK",
      "hash": "875e0577157f743e3346ba95f1d944d08e54b3cab40d89819dff5f48cd507392"
    },
    {
      "id": "70fe7139a63c465cc26dea3072b795d83ac36ec03f43ea71efb809fcd8a1ec12",
      "text": "run, fanning out to parallel sessions, or freeing up",
      "hash": "7b6a7981201e8cbaa5cee3f4bd18b453d423dfbccbcc01b4a68c53db86590418"
    },
    {
      "id": "dcc33e5e9b0e38626709cc088451607f4beaff783495276b925e5109b101f9a5",
      "text": "context window",
      "hash": "6764434518d37f01df452fe2af0af3f314f8c27a72519001ea14189c5ee42476"
    },
    {
      "id": "a51f2c85f6b135dbb8045cee76f3f31d4d5679a0d2c68277142e709bbbf4c5cf",
      "text": "room.",
      "hash": "ea73d8773540402e7de6840567c52f27986cc4439e3abe132c01dc295199677e"
    },
    {
      "id": "2c410a314e6ade58ca1f26b6cf32e0185755f5dea3d7931f7fa4fb8899feffed",
      "text": "The receiving session starts with zero context — the",
      "hash": "ea4965de941ddba7d9d2e67ef9628b28f9e63b2b71321ccd000077690e30a625"
    },
    {
      "id": "609e8bd70c7bb9e79917459f18a4b05b0e1707b10639bd9e08f5be54ec6ae1ee",
      "text": ", and nothing from the old session is visible to the new one. Whatever the next session needs has to be carried explicitly; everything else is gone. \"No return path\" is the constraint that shapes the carry: the new session can't ask the old one what it meant, so the carried material has to stand on its own.",
      "hash": "95266a469dae97a7f0c9e270980228aeee00ecbdcf54e484db0ee2a42b9f583d"
    },
    {
      "id": "da9b1bc021e94f949889ac9a85ad6402577d0802dbae43fb6cbf786dfc9d3949",
      "text": "Mechanism",
      "hash": "3489a4c81c349cadc87ab637b3d9b215c40589a3cb6b74f2a0563f2ff4f6e9d1"
    },
    {
      "id": "0bdde4678643a32086d769f80c8cd95ea9d926afae96e5e370f24dce40bfbc09",
      "text": "Form",
      "hash": "2e0e960ab3204127b1dce399c9984c81f52a79f4d85cb0c3afddcfcfe8a2b48c"
    },
    {
      "id": "b8308588a24fb400d43817a65f9e2aa7670cfd5393a14264ce60a2911b8fb945",
      "text": "Properties",
      "hash": "ae43692b2a310b8ed2443d2b7d2a3e4cf0b6d73115badd72831b3d22381f235f"
    },
    {
      "id": "8e1622bd22a694055b7985da04b39d51cbece1465651d5ee83c019aaa1ed3bf7",
      "text": "Handoff artifact",
      "hash": "ead240861579b1a7860feadb4392025d981ee640559b4a3c75c64eba36517a48"
    },
    {
      "id": "1f9bfaf31e3280187614707f5c053fa0114d6e9736f7fb3f9a5e6aa95965fc4c",
      "text": "File in the",
      "hash": "27871063669492c97bf95b12331b1603d0f79563b442a310a378ca25b7f74fb3"
    },
    {
      "id": "481e47a309c16068741f4c3173b807c764102f193a43aaf8ed555c949a0bb5cc",
      "text": "You can read and correct it before anything depends on it; reusable across many sessions",
      "hash": "d82fad0fea298e9b83c52017d6772965712c05168dbb92274275f5992de0304c"
    },
    {
      "id": "3f94bc8b17ff10d4b44322246bef89991bbf719f124ede4ff79acdcb48c9ed50",
      "text": "Compaction",
      "hash": "a0ade140bc8e408639e51492b949bc4d31641625ef070015b5d4a5e92ef0edb0"
    },
    {
      "id": "8ad047ab93346408664a8e5ae84af8694f806cb8123436d3799a9fcf96e59733",
      "text": "Summary in the context window",
      "hash": "ad5da2b36776e5d6f1440340bb75164c5a69323f49526945a4c77bd0c8d22ce7"
    },
    {
      "id": "ce9bdeba85954fcf5cdec717aa28ec043b4e4ba0d0f5434350722289a39fe2cc",
      "text": "Automatic and cheap; harder to inspect; feeds one successor",
      "hash": "18e79875bd411821e2994b33f8cd7caa5f9f316a4a1ac5f3516ed8c7fe675c66"
    },
    {
      "id": "587459a0ed2f1c63d37ed98e98ea86acd463741e6be4c09abaff17c6c2c83872",
      "text": "View Table",
      "hash": "aa0a0f6baf57a603925533ee10fab7f6bb4e7002e7d8df106b2bc671e1d72567"
    },
    {
      "id": "9db249324daa45bd45eff92d57f9d6d5a5a905ada5099ae97e2b063c8ab884a9",
      "text": "The visible failure of a bad handoff is relitigation: the new session re-opens decisions the old one had settled, because the carry recorded what was decided but not why. Judge a handoff by what a session with zero context could do with it.",
      "hash": "806f2723bbc23123add6b53c6babea56f3da3d1d826d6e29c53ebbae85a79c51"
    },
    {
      "id": "0d9df1842646348e0db6fa1c37a9defce5b5f3b9cb663de2cf15df63d4bd0021",
      "text": "Usage:",
      "hash": "2bad3eeaf33caffe3bc9b482b4934ed19eb4ec3614c12373e1a5c5f8948217da"
    },
    {
      "id": "0f299a5b44b153ee891e30ef0d55e039a60f79bd949fa320cbebc832e29fb236",
      "text": "\"Planning session is getting heavy — should I just keep going?\"",
      "hash": "b1b927e0e9523d274d1d4a477af4b85e20da3d22b8ef6660cd91f73a8d0b6fcf"
    },
    {
      "id": "7adbcdcfef79597ba554c88301a0ec99d23284c9944eaa0f981b8ca14cf96a3e",
      "text": "\"Do a handoff. Write the decisions to a doc, clear, start the implementation in a fresh session reading from it.\"",
      "hash": "b8bd464917ff673abd8f5cf50d3523c4b2d93ee2be0be920237c11a09efcb74d"
    },
    {
      "id": "e9f8e4dd9b500dd7a93a95e37a7db5e6580cb62bc3eb50eafe9b46db504db39c",
      "text": "Previous term",
      "hash": "735604aff9e8f2192b83df4905cfc8e395613e0ce05f8ca85a1d2d1d44fd59f3"
    },
    {
      "id": "49e920ec7d7bcfcb05527c9921b2f2927dc3e8d654679da878954f1ce5b60b0a",
      "text": "Clearing",
      "hash": "06648760a765043c7be785f4e63ebea0fd0dcd056d36d53d153208749e757840"
    },
    {
      "id": "e4aacb3ba498c729a83cc40fa3b5c4932ba65a198c37592e9815517f67ec82bd",
      "text": "Next term",
      "hash": "5219c7ebdc0e098aa6db6f09e405c1b17ab75f1082862906a872e10a16818f9e"
    },
    {
      "id": "9bc770d003630a945d5a619629aefe05447970d43aa32a81864a703648d1a7d1",
      "text": "Primary source",
      "hash": "a518c683cac9ab4d00390db41fe8a1fb150258d23d103dec32e0017ff94a0b5d"
    },
    {
      "id": "d8206480f3a0a942ba9c20665c0c5f48fdb1515156d0549ff3b41500428e5709",
      "text": "Want more than vocabulary?",
      "hash": "5d5500a083006a1606e84a03c018904d01364631c6baea4c7a3f8f3f62bf94dc"
    },
    {
      "id": "59f4b54eaf9b8e635d23a5335fd1cbc7fd9dc52d0d22390936a6ff24f8ea3ef9",
      "text": "Join AI Hero for practical skills, thinking on AI engineering, and resources that keep you ahead of the curve.",
      "hash": "a082f7147e30da6afe92268d5668a530edfff13e64934f8f63f22c098db86133"
    },
    {
      "id": "806f1627b00690129e5c0697960c7746ec92341b46fd51cea73fa74e6b8518e1",
      "text": "First Name",
      "hash": "96ce6e6193a047260f5c32aa416d88b6e8959111f43f98457af9cc009a0907ad"
    },
    {
      "id": "e5b09d75da6c0de38ff0795621941690d3952e14ad26e1201780c34ca2b07a03",
      "text": "Email*",
      "hash": "61dff02026341a6e553a56fc2ba214a76ad68c18cc67bf732993cfdbd51bb8b4"
    },
    {
      "id": "13aa37eb656d8d7b55c18bfbbe766a252fc2427e5de927851b035a6f25896ace",
      "text": "Get AI Hero updates",
      "hash": "81b46eab414c141d6dcd85a5bd534179bf54a3532469436d693c437e9de3a90a"
    },
    {
