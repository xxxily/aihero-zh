      "hash": "e22820fcf5cd90e3fdd99a7569e0ee2f30eb7ebadfb2fe4d159b30c166ff81b7"
    },
    {
      "id": "494d8af6debe034205153532c405b52e36655c045e206d263d0b47432fb1ba4d",
      "text": "Failure Modes",
      "hash": "2330131b5d9793d4023783aeceb087c7880f12ec9aeb2d9334466709764226a3"
    },
    {
      "id": "b67aa82705a8e86520f89716ddb8b26390b1bd8060fdc615e14e629d67b4f054",
      "text": "Sycophancy",
      "hash": "3ea44487a35802429565ace3d346af85ffa355f51322456406c67ae05fbe8aa5"
    },
    {
      "id": "b0432ac30261604b9a8453f6d5defc58d61945167246a724cc07f4ddfb8eb070",
      "text": "Confidently agreeable model output. Caused by training that shaped the model to favor answers humans liked — including agreement.",
      "hash": "1a45692a24a256a27977a8d81943c4f90fd99ba0ef218beff12ab39329bbd276"
    },
    {
      "id": "bda5c4b979885a9a4c5cd2d86e42b8a100f33c87486856aa130cc239eb41c14f",
      "text": "Matt Pocock",
      "hash": "2fe2c13509fbd45ec2578a74ef8efda313caad4f19533a102ca7d666ed60881d"
    },
    {
      "id": "4b39997dfd5e67c3c9205206ed689759490ae5f66fb2a322ef3b4cce71e2f90f",
      "text": "Copy page",
      "hash": "4104018941ae3ab016c117887a91b4f933f28e36c587b8983373fe9377ce34d7"
    },
    {
      "id": "02716796b89f5a69164f0d3712ade56acd9d93fffc908c0d2e16755193f7090d",
      "text": "Confidently agreeable",
      "hash": "bd4fa5c4228ae4369591f878a0ede8b1609823044fff798a541e1bbf5ebb973d"
    },
    {
      "id": "18495b866e40f941098708eb2a0a96cba4ee5dbd30259e9dc92d84cc013bbbfa",
      "text": "output. Caused by",
      "hash": "19bf3cfcf261e67e2639f3e8c61879dd0266772927b7c92388f4ead0a3beee43"
    },
    {
      "id": "162e77ccec6ddc218d69e26affa0695b2d37328754b2ce44020a88c5eed2e871",
      "text": ": the model was shaped to favor answers humans liked, and humans tend to like agreement more than they like being told they're wrong. So the model learned that agreeing is rewarded — even when the agreement is incorrect.",
      "hash": "a4a04d84562f9558f52357193e85df782b1f6da6725a3d839c8e837f07daf7a2"
    },
    {
      "id": "be1f4eab01de21d52fae68fd788db88b4250893f51cac3e35fe127cc65fdd3eb",
      "text": "Surfaces as:",
      "hash": "37d7fac4f451763fc08f5ef9a6890d566cd245b243f0367e2983ddc643d4100a"
    },
    {
      "id": "9a63842afdeb47a3d0e9f76d461d2003d7819a3e648dfc55372f3597a84878a4",
      "text": "Caving under pushback",
      "hash": "353aed72f53ee11ac6fab15c1c23277c1458380edf9e93e040fc0b5dcf94b044"
    },
    {
      "id": "34c408e3c5eec9230b3b745416374514718025aad8586edb65bf09ee741d5ad2",
      "text": "— reverses a correct answer when you say \"are you sure?\".",
      "hash": "94be315d6ed925abe7391460a5301335c604f322f80f4b74fecdfbf4a0850c71"
    },
    {
      "id": "be12b4c2f21eb7bf53fb7d4e95bdd0a2695a5c94b2c06036e4ad4804d712ce45",
      "text": "Praising bad input",
      "hash": "246e08b8f7d750fd9402f835402f65f6e724387b95bbe387ed1ee1dc39179580"
    },
    {
      "id": "7f74941a18cb1efd989276eb1b03ec53707252af9d621d0901989064e9fa98b4",
      "text": "— agrees your broken plan is brilliant before analysing it.",
      "hash": "20b3081f07fe9388a07e92302ff1048274cfdbc6cc2a54dbb85a7b45237b74bf"
    },
    {
      "id": "15d04e42de865470bac3eca0472cccb35a370a7dcff14613e8b58267af96cad2",
      "text": "Biased framing",
      "hash": "aafc5545146fd0be88d155648d3ce9c135fca92a666a2c41d94575cb9767fc9a"
    },
    {
      "id": "4ccf539d7e6eb29e20c0b87ea834b19e5561735fc7e1da931884c91174353392",
      "text": "— review skews positive when you signal you wrote it; negative when you signal someone else did. Same artifact, different verdict.",
      "hash": "f909d5c10795e16029b30f86c944289ebbd7b32fe148ab91810602f7fb2afa5e"
    },
    {
      "id": "2188ce59cf3fa45a874105dc5ab916a9d88fef2bd8339af25f0a40f9022ad257",
      "text": "Mimicry",
      "hash": "71623e6fdfa9d880f56c582eb8efce7bab866bb1605f46b62a7eea0e832e11ed"
    },
    {
      "id": "d78bd1f7aacfbc36b2b22dca4617df8891173d5b4bda0937ef81b35b7a971b83",
      "text": "— repeats your mistakes back to you as confirmation.",
      "hash": "b3105604e2466ec8683fe6a2ffaa2834e0c9b5bc41151a3fb314bcf6c11cc605"
    },
    {
      "id": "0fe9be12fc22ffebae62c682f266158157c6ff925a19e01a1d9d8f5924400543",
      "text": "Diagnostic test:",
      "hash": "e4ca217b3e83458cab68a3d691bdecaf12d7491f8a61389bc5a4edb039226e70"
    },
    {
      "id": "7ae894dcaaac472b0166148e37d2124c43a2038fd4132b45b6214dfbf5cb8f85",
      "text": "would the model have said this without your steer? If the only thing that changed was your tone or framing, it's sycophancy, not a real shift in analysis.",
      "hash": "1a4220ba8ad1b0e70b65a789fa87482f96106c854eb3a4281b48fbe5e8be6f8a"
    },
    {
      "id": "02f58cb6dd665f708ec303cc5519f9cf14a3db5572b8a85b0f2b179687a8f832",
      "text": "Fix:",
      "hash": "943df968a5021d330748f0790b2bf2724966a93a16202e196b3d3b4acdf1e5ac"
    },
    {
      "id": "cec59d48b7d8d8308ea0d2b7fd08a29c5c526eb8c5b6ae002241b93d6fda71e7",
      "text": "hide your preferences. Phrase prompts neutrally — \"review this code\" not \"is this code good?\".",
      "hash": "c12dfa6c5a697e6859e9644d77133ca9920ec924b2b965cd7c98c3071a8c4a29"
    },
    {
      "id": "8d5245ce1bef37b3198c44c735a3fa3ce0f04ccedd0cf7809732df0c5dec42b7",
      "text": "Avoid:",
      "hash": "0c98d3dd1920fdb71269240ba1ce3a7323099760ecd0b295f071aca6b07e30df"
    },
    {
      "id": "30e565675eb7e20766a88a50acb79140309936635840bd0789dbd529b3f7d137",
      "text": "using \"sycophancy\" for any wrong answer that happens to please you. Without the diagnostic test, the term has no more value than \"wrong.\"",
      "hash": "d4d28d7144934a006ae37e3783948bed026f2ade34ecaadb7c3734b1947df157"
    },
    {
      "id": "b987c398b50479bc9e6674456bbb81b157d4c86d72088da8a572b50371bdb1a0",
      "text": "Usage:",
      "hash": "2bad3eeaf33caffe3bc9b482b4934ed19eb4ec3614c12373e1a5c5f8948217da"
    },
    {
      "id": "359f24193e7d361e400227527770dda65f990823873e1ffc6f2ce66dc69b829c",
      "text": "\"It said my refactor plan looked great, then I asked 'are you sure?' and it walked the whole thing back.\"",
      "hash": "7cbdb8c5e4b7f279f8e64b2db200ddcc32e52ca225e6e73f1760b3782e7ddcde"
    },
    {
      "id": "55aa4589ee776a970e52f66e990fa37dde22ffa57c63d049bd1acbfcf4c620ff",
      "text": "\"Classic sycophancy — it agreed first because you sounded confident, then caved because you sounded doubtful. The plan's quality didn't change, your tone did.",
      "hash": "f6759af38b9e3f1cdaf177477043a34f0c1ac0e96eed795acced80f57719d286"
    },
    {
      "id": "f1b50d09ee80be0245573b95c921864b2774f7dd26685d459aad338664da89e1",
      "text": "Clear",
      "hash": "83b12c2216efb4fdc924e1deb5182e905e4926ed0c1c324d467107f46d5a26a9"
    },
    {
      "id": "90cac66cf8021d132277f00bde4a7b4e579ad50aaca56244b78d78207737b2e4",
      "text": "and re-ask without signalling either way.\"",
      "hash": "ec068795abf15000c597d8ec3af83a57b6e571838fb24852d8b1bb5419f3792a"
    },
    {
      "id": "ddb64db01479b892765a1f0f64face0ed2a0b1cfc0132f44736d0632229240e3",
      "text": "Previous term",
      "hash": "735604aff9e8f2192b83df4905cfc8e395613e0ce05f8ca85a1d2d1d44fd59f3"
    },
    {
      "id": "f6310c2d1a9b51f26ab3e1cb430f3931df4fac7fd834e9e959456a58f244f9e0",
      "text": "Sandbox",
      "hash": "67fc62497e85d81bc54ea07aa87dca6868cd470e95d7281155a8eb532ce60009"
    },
    {
      "id": "e76b90aded5ad225b944edbb0e06a332abed8861d6f6fbd46d50cfcfe3caffe9",
      "text": "Next term",
      "hash": "5219c7ebdc0e098aa6db6f09e405c1b17ab75f1082862906a872e10a16818f9e"
    },
    {
