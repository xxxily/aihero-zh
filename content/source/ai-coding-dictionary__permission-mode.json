      "id": "e627f3ebfe4580da5fc50e9b21a8f5ab75237a15b401144c23b6815ef08a790e",
      "text": "Permission mode",
      "hash": "c7a8e6db5cbb4c7180dc0a588ac85d4c5e98d7d9f5b92c87bd146758e6023463"
    },
    {
      "id": "57b9eef2eb621e9acf23fc2784c6c116dacdb6c39ca54f098e9fd43fb441fb42",
      "text": "The permission-gating slice of an agent mode — which tool calls trigger a permission request and which run automatically.",
      "hash": "65f78d889a7386860dcc1a452dd895d9f68b6d347db12f22d38ef3e4f50cdfef"
    },
    {
      "id": "5150627a01ae72a208bd2b1700eedc3561d6aef130f11d3c8babc7915cccf40d",
      "text": "Matt Pocock",
      "hash": "2fe2c13509fbd45ec2578a74ef8efda313caad4f19533a102ca7d666ed60881d"
    },
    {
      "id": "5d5f52468f8ed574456db30a3614d76069c18c78e58d6d572af591c7c165f01b",
      "text": "Copy page",
      "hash": "4104018941ae3ab016c117887a91b4f933f28e36c587b8983373fe9377ce34d7"
    },
    {
      "id": "59d26b69eb850cb7c6454619eef2823f2e0b93ebf85bb806e455dcbeefde070f",
      "text": "The permission-gating slice of an",
      "hash": "3511cde9252d3c3b8c06465538542d383d74b461125997568ce4cdd58b11a3e1"
    },
    {
      "id": "ee8756417a5258e16a0057c6bc6599e02c44829771197b31a1b07eaacc51d819",
      "text": "agent mode",
      "hash": "dc977367e8bed28d77918080271e3d45044d91fc14135e54e7282cdcd4eb7042"
    },
    {
      "id": "ca0e3a1af2e06b25f29fc329c68d0f8fb0a9717d4bbcac57824a898b446402da",
      "text": "— which",
      "hash": "c9c361bb6b0ed36f68a4817a81f41d28aa1110c50137a06e74f1b79ea98a67c6"
    },
    {
      "id": "db830cbb8db74b8dc8686b203fff041b8ee2c47588c934b784b8da410e84c61d",
      "text": "tool calls",
      "hash": "b102cdc6032df9ca67169a6d620fba86a9b0344b8dab71565a5b230deadb5e68"
    },
    {
      "id": "20fe5673ba032dd2a9eb1861781687170eab8cc00631cfc3ac6650a0ac73f076",
      "text": "trigger a",
      "hash": "3f4abfaef6a0393fd19103047ba060db954a767273d166d733e085cf26933b40"
    },
    {
      "id": "97ad6bde1831aa1f3a4993d9a0e03a8dfb008ba7be9886cbba1060f2d363791b",
      "text": "permission request",
      "hash": "6d1cb846563c26176b664aa8cb40c3812133fcb2e085df730453168a1e7632ca"
    },
    {
      "id": "8a73e483381b7a75ce0bb225e45c32c1fc29f6952fd7212183c2e7d98a0f518c",
      "text": "and which run automatically. The original purpose of mode systems before",
      "hash": "374765534fe192c91b09a9633a06f30da1c7a0a73f03384b01ad769e11da3634"
    },
    {
      "id": "373b270f5f307936443f5ede9aacd9a1f607ada6c871be3cc2aca0745e3cb97b",
      "text": "started bundling behavioral instructions on top.",
      "hash": "557728312b8f8d9ea48e4126ef465972b5b773df29054a256ce56de1b849e650"
    },
    {
      "id": "dee29a77700666fbf21050a341182f89975439e8a4b01b17f6ed9eccc56b37a9",
      "text": "Harnesses ship a ladder of these modes:",
      "hash": "52d03e649aceb3447d39e8ee8c1baf5c755cb64b379c82849f1ea397549c062f"
    },
    {
      "id": "ac00e0b8d9666e9bbd9a2db3c6823d38b04ae88b6842e8ae06ae3f64c49066c3",
      "text": "Mode",
      "hash": "5e23ec6a300dc60a79641769017e16e9bf042cbd8fd0a54586a048ab9da972ff"
    },
    {
      "id": "160c92dcacaa3e2a51bb0e6677124b3dae494ed7b79ccad30107457d26144441",
      "text": "Reads",
      "hash": "7f3e8bf052d3900e743f7c670197f168ae3649c08144c8cc39c7d666a5f0b92f"
    },
    {
