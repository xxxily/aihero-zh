    {
      "id": "ecd7bff9404ac42d457e6d9a81abafdb1f2da7e83e937566a380fc5c4a479286",
      "text": "The AI Engineer Roadmap",
      "hash": "0ecca41f97662f50fc4210f00b4d05ed73257d862ecbd642b906cd7da42d4092"
