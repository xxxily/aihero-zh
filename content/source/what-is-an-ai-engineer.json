      "text": "Up next · lesson",
      "hash": "7915dcb8d2117c7a6a8fa6d5a1901ad5fa87b609352be8aca042d9a52d097c78"
    },
    {
      "id": "1eb92ad2713b186d49b9af03a3cb77f3916193c4e51348bb73eac94fea9fdeae",
      "text": "Log in",
      "hash": "c189840cf7e2d6f6fdeefde1ac59dfdf50bb75642eb569b4e38a5614d6f12ac2"
    },
    {
      "id": "d649b4321fb8172e946bff82930da0f7efdea9ed0c56f63260cd6ae154456292",
      "text": "to save progress.",
      "hash": "80e970a1e5533be8e269820a64ae4280cb79d1ea60f31e0a89863e1ddd0aee48"
    },
    {
      "id": "391bb5066489a0d81f27efef6b1cb7fa8096e8deea2cb0c3b98eea1e77826205",
      "text": "Learn",
      "hash": "ce78afd0e6a225ecac96a6812b9d192e7eb35889cd5237beb38b50375b79d8dd"
    },
