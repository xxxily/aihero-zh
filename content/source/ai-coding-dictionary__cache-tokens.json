    },
    {
      "id": "89ce2f36ec72296de27b5a55bf85ee2ddeb482dbb6b94358ab189ceb4aeede6c",
      "text": "Topics",
      "hash": "e22820fcf5cd90e3fdd99a7569e0ee2f30eb7ebadfb2fe4d159b30c166ff81b7"
    },
    {
      "id": "db34222c22906893e69832eaa0e8ccefaf01724db36baa7fdbc6eeae823f6a11",
      "text": "The Model",
      "hash": "1954409637324f1c3f2cab102211fd161a6cd1c270252fc2e1297a69ab9a446b"
    },
    {
      "id": "9efe75b9186abdfe3f056833605c8f9dedcb08f553a985a159dc88adc0aa2412",
      "text": "Cache tokens",
      "hash": "cce47e61662627e3233cc32f7d9c15df14bdb29e105265edb1add04660d4dc43"
    },
    {
      "id": "d1f13c004c8379015004aab867f2a5edfc17ce14303e48ea0b29ef9b57c2992c",
      "text": "Input tokens the provider has cached from a previous request via its prefix cache, billed at a much lower rate.",
      "hash": "aab171121a71715bf9cbd1a080afb6dd7bbc8b2b7088d883d346674fa2b0d321"
    },
    {
      "id": "c61d31719037dae66d7745ff60b4b671264273168c43aed5d5f5ef3188815c56",
      "text": "Matt Pocock",
      "hash": "2fe2c13509fbd45ec2578a74ef8efda313caad4f19533a102ca7d666ed60881d"
    },
    {
      "id": "518c3c68d4167d70c1a6440acee6dbc326676f87f2a9c0ceaa58fa447e80f291",
      "text": "Copy page",
      "hash": "4104018941ae3ab016c117887a91b4f933f28e36c587b8983373fe9377ce34d7"
    },
    {
      "id": "43b3643d443199f4e613cb24f58e29a3067b490b440ca004645a42efa6c4c317",
      "text": "Input tokens",
      "hash": "dd856eeb50463bae46757d871d833fcb63d29a39356e7db40fea337f6462c947"
    },
    {
      "id": "437f4c5068ca880848a8312107da4b588504bc0d2b88b9640ecbc1f58615e04d",
      "text": "has cached from a previous",
      "hash": "49788aad52c88df99cbcc5b9550e2ae7501ba0ae817b51661258dd733523e475"
    },
    {
      "id": "8e170abb00c0c35d467907de3ce7d2c57ea9efe1fec45783de2fa12e3904a2f0",
      "text": "model provider request",
      "hash": "3004d539f1f0ae7a40070d95ba4a1323d874684827edf4d55b29a1056f8da7a9"
    },
    {
      "id": "01f04ddd590f59765c46a652ee897944e2da482e546c8a38dc2d7288712874c0",
      "text": "so it doesn't have to re-process them. When consecutive requests share a prefix, the provider reuses the work via its",
      "hash": "8cc70f44146605b4a6dc41e5496e4a4571a7a9f224758c2f944ee401a599498d"
    },
    {
      "id": "bb1a9971351f987c3f01c33c0237223d1cdfdd2d122e5cc6e999e18c2232c6d6",
      "text": "prefix cache",
      "hash": "2cdfb6c2d97e750050af7ef5f0ed3c788737a1776e6c1f740f856462592ba13a"
    },
    {
      "id": "a4a66f44951bd06a95547f3fdd95d62a87cbc8ba9e5b0abf1c1c7fafa817f839",
      "text": "and bills the cached portion at a much lower rate. The lever that makes long",
      "hash": "d36091ae9526c17ab62e5f19cbc4ff03dd1229438ede8a52dee1f6218d052a40"
    },
    {
      "id": "6bde7a812be56d85e0307322a69d27568b34b5ac59638e11efb2570a0a23bb8e",
      "text": "affordable — without it, every",
      "hash": "95a490790488d956b85a9419cbd2f4eb3555de80e3b94ab5e78e545cdf111dbc"
    },
    {
      "id": "4bc2645da7b1f3323984316662adc65e2b9c4a961ce272169ea8b99cb554fa84",
      "text": "re-pays for the whole history.",
      "hash": "5e99149fed2731d99f344a937c36a38ec8bb046991d2b8c665becbd64f4edc73"
    },
    {
      "id": "07233d879f875323020c2aa3ebf56a2ccb2a72bfdc0c317d45aefcd67874daeb",
      "text": "The reason this matters is how sessions are billed. The",
      "hash": "392b544e20f665435efb4d04c1e90bf711f5b95202343893b1cb289dcf7227ec"
    },
    {
      "id": "658c03162442845a824be89e6ef428f7bbb98dd6a12f6d6c55e0afa63419079d",
      "text": ", so every request resends the entire conversation —",
      "hash": "645ffe2c1620df786c85f1556feb208e10775ba087b725f05c58e81ef09a225d"
    },
    {
      "id": "7f75fbc7652e4fb4f8b1f7e28cb53cfde036178ca05d18356f39f37072d2ea0f",
      "text": "system prompt",
      "hash": "e16202309c92180728dd7fd1c59f16004a6d5ee245538c28d2a9a22edf2dd2ab"
    },
    {
      "id": "ae058e5a0240e7a9a10ce2055eefc07adf2ebc5092ca8a21f77ed0c5b44b0a6f",
      "text": ", every message, every",
      "hash": "9e041e8072b4a17f7d7ef7ab7a89aa133d8bf1f231d716ce07c3f230ed991eda"
    },
    {
      "id": "8d4c760dedaec6fa3a644a65ade1a7ef67f285e70d5720dc63a0e7e77b68646c",
      "text": "tool result",
      "hash": "496514e28de40f2624fbc4fb01c89afaba32fde82d1e1d6c19ab43d702f7a230"
    },
    {
      "id": "aefbf60a4540cad2fb726f62f1656b1bd12726790a4ae3cb1b87e5f3c8203792",
      "text": "— as input tokens. By turn fifty, each request carries fifty turns of history, and you'd pay full rate on all of it, every time. The cache changes the maths: tokens the provider has already processed in an identical prefix are billed as cache tokens, often at a tenth of the input rate or less. On a long session, most of what you send is cache tokens, and the bill stays sane.",
      "hash": "407d5ab25114a30f6ef9d219ba538eba138fc47e57285738ee63d06f2b25c71b"
    },
    {
      "id": "da83efb50362177adbcad451ab707322fff4785d10b187acbf57cc3e8260ad7a",
      "text": "An example shows when tokens are cached and when they're not. Each letter stands for a block of conversation content; each request sends the conversation so far:",
      "hash": "0012b2a44fb128eebc23622b9cbce0674a8f199a11a23408a71811288193e091"
    },
    {
      "id": "bb315c23461e4feeb96ff41e123860dd13ec78c79bb6dd48ec212c5a0e15a4b1",
      "text": "Request sends",
      "hash": "1ef634d1a71830c96fbcfe906f6c51c4396143287607c9a27c5e387eef32db31"
    },
    {
      "id": "403cac2420dad37f661353f942c20735174f4714d9030885a66548d84d3bd188",
      "text": "Cached",
      "hash": "a251c18205f10e5ce440c6c940270de4b8ca2bfd19ad8d9a15e28590a9fa7a13"
    },
    {
      "id": "c62728751e6ab7eb833adc8729927e0b9d934a1e0a17ab426c6c31ad949beeb4",
      "text": "Billed at full rate",
      "hash": "5eabc7adcfbfebc7b46f1dcd6461355ab006f17894511afd806b8ef04b1953a2"
    },
    {
      "id": "10f1a86ec039f635f03fa50b2633a69521c5c39a31aaa6b03e80ce91bc9e924f",
      "text": "Why",
      "hash": "d3ae14a50bfe463f804c73c9fd16e88c36bf5a0bf4a56f98ae696a91eb2de149"
    },
    {
      "id": "b2da9fb3774bde639be7a98281cbf905623431eaceaeaa7c28702f6b7ab4f661",
      "text": "First request — nothing to match against",
      "hash": "88459ab6cdcb34a3a546d4be1868742b9aa42b62846a6e2687b10c120a5f9030"
    },
    {
      "id": "8d429a905458c02bddc51404c533fc558fa67e4b86ca3deb1f44c84e556c3a6f",
      "text": "is an exact prefix of the previous request",
      "hash": "b4326df4d608d125ea0f1c87d6d6f46675915f9a26c642d47d3ff0ad9920384c"
    },
    {
      "id": "db3b887223f365c1a9fd99984c135fb82f3647bedbc045a85867df83124ce792",
      "text": "Prefix still intact",
      "hash": "5a3426df6203dc3e20c41760e0d35da92bf093999c308a8647bc1c10a0d5dd59"
    },
    {
      "id": "562d8bb9461ae64de832e4b43ceacf016b60c686bba0194b32932e378b6623dd",
      "text": "An edit changed",
      "hash": "92f5412fe8af37dc4969002a5ddaf08c9dd2b441ca19873b8667c58b7b9521f7"
    },
    {
      "id": "63e0079db3950ef99f54b785336363b080882fdd22923eae05321319f3e05735",
      "text": "; the match fails there",
      "hash": "1d6723a71bd71718a489baaa5895bc1a216a3e8ab4d629cf5181e4f33f17cdb3"
    },
    {
      "id": "084baa41440080048848aa0c7ea2e9a07bcd656d9f9bfecc97ca5da4d2a694dc",
      "text": "View Table",
      "hash": "aa0a0f6baf57a603925533ee10fab7f6bb4e7002e7d8df106b2bc671e1d72567"
    },
    {
      "id": "e6d13e925498f207a8a1dcf422c9208ac395afd2d0c9652bffe19c73002ac92d",
      "text": "The cache is fragile in a specific way: it matches exact prefixes. If anything changes earlier in the conversation — the",
      "hash": "0537e9a0c79bbd9ba583823fd3bd730dcfa26dbf360cee9cbd2945721c415157"
    },
    {
      "id": "bcf388d2d3e3c43e4b6dca5d9eb9179f8d52c07b716cbffef8dff34150da4ddf",
      "text": "reorders content, a timestamp updates, a file's representation shifts — the cache misses from that point onward and everything after it is billed at full input rate. Caches also expire after a few minutes of inactivity, so a session resumed after a long pause re-pays its history once. When a session's cost jumps without an obvious cause, compare cache tokens to input tokens in the usage report — a broken cache shows up there first.",
      "hash": "67947f1b3c0381797b8fd63ebc082c1f0381cdf34a990031122011fa31ecb69f"
    },
    {
      "id": "c037809688cb48f9335cba097d51cb51d843c650034e2750bd8a60ca02fbbaad",
      "text": "Usage:",
      "hash": "2bad3eeaf33caffe3bc9b482b4934ed19eb4ec3614c12373e1a5c5f8948217da"
    },
    {
      "id": "ea9f764f18302a55e70c2835f1a621cfc81d1372cbbfe668c81796f3494a684b",
      "text": "\"Cost on long sessions is brutal — eight bucks for a refactor.\"",
      "hash": "c9138e26dca89e56118289fe119abd106d9ac631f3edd195c74618c124353bc3"
    },
    {
      "id": "ca31175adb3dc36447339dbc2f61b448d03bf708bf4f68de9be01bba243397c1",
      "text": "\"Check the cache tokens. If the harness is reordering the system prompt or files between turns, the prefix breaks and you re-pay full input rate every request.\"",
      "hash": "5b2f9de3e27532230ca48d043d84a8b64ac8e9292f4f19ed0a76530bb2a8c308"
    },
    {
      "id": "1f78f9a31545d2255136c156eab1739b4498790e4cd82ee917e1139138cdf779",
      "text": "Previous term",
      "hash": "735604aff9e8f2192b83df4905cfc8e395613e0ce05f8ca85a1d2d1d44fd59f3"
    },
    {
      "id": "068c1d6f67db3d74e3f058e0877b096ce665a93f457045e6731dff08aabd3d72",
      "text": "Prefix cache",
      "hash": "6d2f1e1fefb634a9d9c07247312a3bd2471f20af5deb07dff137143ede4f3810"
    },
    {
      "id": "1e32ac6af61a445526854272a53c2f71040ac78c56845a2caa1aa8d4b2ffa4d8",
      "text": "Next term",
      "hash": "5219c7ebdc0e098aa6db6f09e405c1b17ab75f1082862906a872e10a16818f9e"
    },
    {
      "id": "ff4a7511a4d950a26617dba58b4a1bce54fd703fa1886ae14066f7c3c02daf5b",
      "text": "Stateless",
      "hash": "f0916a93b0a1776f11d26f8ea012555868465f41131bb6037f712455ac330788"
    },
    {
      "id": "89e1d1a74633efc76a51815d7d0f32ba3e4e31c9286b31e35ef4d2c9d4b826e9",
      "text": "Want more than vocabulary?",
      "hash": "5d5500a083006a1606e84a03c018904d01364631c6baea4c7a3f8f3f62bf94dc"
    },
    {
      "id": "2f309cd9092909b0bea9489cf84a32ce3aed7e4d77690c1f275854ab3c749a7a",
      "text": "Join AI Hero for practical skills, thinking on AI engineering, and resources that keep you ahead of the curve.",
      "hash": "a082f7147e30da6afe92268d5668a530edfff13e64934f8f63f22c098db86133"
    },
    {
      "id": "4c59b04cb40164283bca5963d54591a2a3fd67d78c63914baf6b95887cf73de5",
      "text": "First Name",
      "hash": "96ce6e6193a047260f5c32aa416d88b6e8959111f43f98457af9cc009a0907ad"
    },
    {
      "id": "c49364cc14be61e07cbdf0fb88810b061d5638601c540d6d1e8dd864cff42473",
      "text": "Email*",
      "hash": "61dff02026341a6e553a56fc2ba214a76ad68c18cc67bf732993cfdbd51bb8b4"
    },
    {
      "id": "e615c4012ac2615ee4ff8f8c5b9bb03d79d11e9e7976fe252949a0ccda0ee9e0",
      "text": "Get AI Hero updates",
      "hash": "81b46eab414c141d6dcd85a5bd534179bf54a3532469436d693c437e9de3a90a"
    },
    {
      "id": "e9c0d22180c053f995b3bdd7dc09156c94c3ba97ff7f35d457fcae9f67beb0e2",
      "text": "No spam. Unsubscribe anytime.",
      "hash": "461f8758206b36fd4ddfaf6740b33dc0de41c9c7acb9121525993b781d5e18bb"
    },
    {
      "id": "430d277b872a1be196deec204c59ebe056d141ac9e735dfe3f8b624fb68fd0e0",
      "text": "Share",
      "hash": "29887a5ff9846ccc23327565a07e17fa6dcaea6211f1898ae825f84ae38f4223"
    },
    {
      "id": "811c26d7ba6168e60b89a4e9538326b756896550d316e27269395d70276d2f4c",
      "text": "Copy URL",
      "hash": "b26d1037f1c2da31a0296d915982f12049f91bfedb998b105ce967b73a796699"
    },
    {
      "id": "9707a0faad5cbbebc283c6e59b0595d2b71f68468c7298ea1b3f4d73f75e351d",
      "text": "Learn",
      "hash": "ce78afd0e6a225ecac96a6812b9d192e7eb35889cd5237beb38b50375b79d8dd"
    },
