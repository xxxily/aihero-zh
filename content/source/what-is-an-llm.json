      "text": "Previous",
      "hash": "a57b08a480b822a0a572b993391c292ede593bf8000b406675b180bbb16260fa"
    },
    {
      "id": "82239f9e3e508e5fbea86d925d15f64f7bfd342f6c8cf0ee953591abcc14befb",
      "text": "Up next · lesson",
      "hash": "7915dcb8d2117c7a6a8fa6d5a1901ad5fa87b609352be8aca042d9a52d097c78"
    },
    {
