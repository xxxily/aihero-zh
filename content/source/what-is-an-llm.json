      "text": "to save progress.",
      "hash": "80e970a1e5533be8e269820a64ae4280cb79d1ea60f31e0a89863e1ddd0aee48"
    },
    {
      "id": "1830c4878d86f4ec4a58d5596a9d4c8793237e97f1464c08be4e07044b52c072",
      "text": "Learn",
      "hash": "ce78afd0e6a225ecac96a6812b9d192e7eb35889cd5237beb38b50375b79d8dd"
    },
