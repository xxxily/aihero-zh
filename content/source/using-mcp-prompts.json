      "hash": "31e6c46bcda37b0d7c6e63cbb8552bf639f2c27caa4698ce6114c876b903ac32"
    },
    {
      "id": "21fb799db696344dd30d606f1f61be12a69397b547593b1f9f7979a8e1bd4b7f",
      "text": "Model Context Protocol Tutorial · 3 min read",
      "hash": "ecc36ba09dde9c0106167a45d5b4739ca9e17c4c06819a4396b34925f12f35f2"
    },
    {
      "id": "c24444a6f67d78bc5ce9ff5a2f86f80ece9a6ee809d9cb51fb0e7aa91e81841b",
      "text": "Unlock MCP server power by using prompt templates. Perfect for enhancing LLM workflows and boosting productivity with custom commands.",
      "hash": "50c53a39b97b5d6795a51e6b5a27ae50386a21a7d2d0fa2dfafd2d2b3e3b6f53"
    },
    {
