    },
    {
      "id": "ae48ca73cd89c7c5c7c8a45df4ccbc6c4823d28cf281e345586619168354867c",
      "text": "Messages, System Prompts and Reasoning Tokens",
      "hash": "3f4abbe2463908b00f5b0843833ac83f093b45c95c2e5ac1c4395162a9512645"
    },
    {
      "id": "0b5faf364c09e3f4669fa85350a782f7f52746fdec2b1b567833d0fb0a72d178",
      "text": "What Are Tokens?",
      "hash": "ee46b60e4092cbeeb7436395b0ac00e00c45ebfd441d53a6c0ad998bad67a625"
    },
    {
      "id": "7b143431b6f3ad03834916c8e3e08b0f2d5014431d6f1caea6b7cebc827d72c7",
      "text": "What Is The Context Window?",
      "hash": "424d3b1d346af8ee28ad019515ce974d4455ac38aabd1de0c6f85c80ad006a35"
    },
    {
      "id": "bf5febb3e9a485d84d6a861b2e816b22998d04440966ac678c34e87e2b4b7fc5",
      "text": "What Are Tools?",
      "hash": "916742818672edbd799c05eb316ebe7f4750efec5d416b1db6d6348acb761caa"
    },
    {
      "id": "9e8126e626640f1382b66247e00e1971cb45afbcbfd138323db9b3d75cabbb8f",
      "text": "What Is An Agent?",
      "hash": "4363a0eaad32a30e59832dae65d5ce46e94404b308512b2a6a68c13044d2919e"
    },
    {
      "id": "245315e4646860dc7517e532169a90cabf18c7a0e75c9c0d0f5a25c1eeb777e5",
      "text": "AI Engineer Roadmap",
      "hash": "29a768799acab15b5a0ee28f241b6e057d0b5ff706c70c3edf7f24676f3d77a8"
    },
    {
      "id": "5d33808bb5364d4abcab608db813f42992da2cf5857737f86aa80a701d01c946",
      "text": "AI Coding Dictionary",
      "hash": "4def77f9388809f53620144510fcc4b6f08662617bcc06a15abc618242e6544c"
    },
    {
      "id": "089cf64374c58230a71cc7074e2dd5dfa5bb69caadf2cdd008f6578e93294814",
      "text": "Topics",
      "hash": "e22820fcf5cd90e3fdd99a7569e0ee2f30eb7ebadfb2fe4d159b30c166ff81b7"
    },
    {
      "id": "d19d0a302b41bc829fd3896848275fd8f1b2aa544c268850bbf58809604590d1",
      "text": "02 / 05",
      "hash": "509c42814075aad7a4fc95e0dec3a0ce48f157c5e09020d6207d7a38d608f8e8"
    },
    {
      "id": "043344daa6f2ab04251b82e871041d8dbe0a2be046842fff7b02a2c0e2a9075f",
      "text": "Discover how tokens power LLMs, affecting costs and efficiency. Learn about encoding, decoding, and vocabulary size for optimized text processing.",
      "hash": "2e5fde99e8431ecca1fa4e6cc83877e4f850daed2787fb9dfc1e179e565e1c3b"
    },
    {
      "id": "7a45e233a2733ab033f1ecfbc33b05298c5030c2b21be426d63e86afcea9fff1",
      "text": "Matt Pocock",
      "hash": "2fe2c13509fbd45ec2578a74ef8efda313caad4f19533a102ca7d666ed60881d"
    },
    {
      "id": "9b0c53f8395a17364c51c49126b4ee5e90f561fdffbc0d4bb580b05ad278a8f8",
      "text": "Subscribe",
      "hash": "cc0e38da9c41790bffef1b88af32d39ac285edce93da766810edc237cb2f1625"
    },
    {
      "id": "51b3c7bbaf6d0f081e6c64b859bce7c41df13b1bf588a17cc1051d39b111dff1",
      "text": "Copy page",
      "hash": "4104018941ae3ab016c117887a91b4f933f28e36c587b8983373fe9377ce34d7"
    },
    {
