      "hash": "e22820fcf5cd90e3fdd99a7569e0ee2f30eb7ebadfb2fe4d159b30c166ff81b7"
    },
    {
      "id": "0fc3232a4d89f089975eda045d44966fb375e88ed4d3132657172b5c61bb9688",
      "text": "01 / 05",
      "hash": "a180046a8e5d29f5cb2b63fc8fce639ede11a5a3b61c942c3eceffaada81c1b6"
    },
    {
      "id": "bd763f4e95ea059652589581c2744961a3ccf80f0840489c2b2c6ad135dc8da1",
      "text": "Learn how conversations with AI work under the hood. Explore user messages, system prompts, reasoning tokens, and tool calls.",
