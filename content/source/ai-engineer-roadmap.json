    },
    {
      "id": "2269fe58828dcc3fc940eabf1fe70b614a947a043114aac26825982be2bf7ba4",
      "text": "AI Engineering Techniques: A directory of techniques for improving your app",
      "hash": "518f58b1ea8d07829108a15616465954c7c4de3727f3560c2eb48c793c68cca4"
    },
