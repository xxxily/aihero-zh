    {
      "id": "b0d874aecfae3b5e8bb1aa6be2e98195a3257d64e6a5ba1ac16f5c05018b5705",
      "text": "Start lesson 1",
      "hash": "4807b65f9294479053540a531b017e8fc8e9abafa633eff06fc9e6f29557bf05"
    },
    {
      "id": "60b4db90ab721191d762c96a027ee730985d15f3998d99a4bbd145f8bf9c5304",
      "text": "Share",
      "hash": "29887a5ff9846ccc23327565a07e17fa6dcaea6211f1898ae825f84ae38f4223"
    },
    {
      "id": "9b6df24a23326a8efd3cc07b164a37aaf3e770b56b67754f134eabfd43ba9315",
      "text": "Matt Pocock",
      "hash": "2fe2c13509fbd45ec2578a74ef8efda313caad4f19533a102ca7d666ed60881d"
    },
    {
      "id": "d55d334b4c1606fd317b294cbcf8b6e96ee263c47b09642f13040a51322afd78",
      "text": "This tutorial is your roadmap to becoming an AI Engineer. We'll cover all the core concepts you need to know to build AI-powered apps.",
      "hash": "bd206c4a9ac51c2634bc97e1e30c2fa4650abb79d56d1d2525140e41f1887072"
    },
    {
      "id": "de2d47ebb1d9449991af00ab60179aba09ffa2504915e2aeeccd925f0c209b52",
      "text": "When you're done, you'll be able to:",
      "hash": "e34298c6c6e40b882fc3bc4635f575bd9613def1589946aba16edb07b7f5c634"
    },
    {
      "id": "3df6806db4b641f1210ee4d0943c8f406372dac68d695782fc1a11b7f8c620cc",
      "text": "Engage in meaningful technical discussions about AI engineering",
      "hash": "3752f942b02572c753ee25a0a96fde944b369630795429651b1d713814e71829"
    },
    {
      "id": "8d8f755fcbc8af1846b7f982d0fd8121ec8dc3d46eefa5e61ccf50786656b6b6",
      "text": "Understand where new AI breakthroughs fit in the broader ecosystem",
      "hash": "9ca85abd73b7c452d6976929d19b7790fba846e051a2689c0ef9f0b870eaa67b"
    },
    {
      "id": "9d87a97baa33597a631953a8c2cdc852e8824d3e39ca342f63c7b2d4608956a8",
      "text": "Make informed decisions about AI implementation strategies",
      "hash": "85d4a0d9302b12e424f352d8d404e8b550c5fdc54f1b1a41fb62cfcf9f09233c"
    },
    {
      "id": "c51955e5d561c486ce91d0325c5c3a3a8ecbe170682c959d771cc5a0bf18d7e4",
      "text": "Then you'll be ready to get your hands dirty with my",
      "hash": "09b1898fe3cbe03b1ebd90637f2d1d6dfeb915bdbf9c843be914aaf915c5c317"
    },
    {
      "id": "d9fb0370bb15b66588fa8e2d842d26dbc4a4a73ab213b90d0b581426827891e5",
      "text": "Vercel AI SDK",
      "hash": "490c9cb0b3e768b12adbd0e81ae2f6fed2915bfe0410ad2c71f0e3d71d1e5c74"
    },
    {
      "id": "15bca6478668ada0858cbe808678c98659fa72c14dee7aaba7775a7f73fe34d7",
      "text": "tutorial, where you'll put your newfound knowledge to work.",
      "hash": "423a99c60895080c4d78f8ea291b0f8b874673f55b307caf44b97eb512bab2ce"
    },
    {
      "id": "55f90c1c2c4d8a69e224ef87057183d971ee96cc4652fa0470ebd4eaf5cf39e9",
      "text": "Let's dive into the world of AI Engineering!",
      "hash": "45694818deb39281381a8243594c2f4fdc5580120afd17f9b70acb96b5800d5e"
    },
    {
      "id": "30dcb863169f5272cf2954d394bae073a8ff6f2ad89a722f18553fb0ec53b4ff",
      "text": "Diagram Pack",
      "hash": "06ec2b5a90542e0189ac4eed248c34c527b5d8a9d95721ec31ff29d56c0bbde3"
    },
    {
      "id": "bc4fd9fa64d55ccdab778593330fc3b6044a7e52b1a4d0a5ab1834bfba711cc2",
      "text": "Want to remember what we've covered? Here's a PDF of all the diagrams in the series.",
      "hash": "4e08b4079db0e972ccd5249aee16fef8bc2141b63181289764ded1240f165bba"
    },
    {
      "id": "a22d0f2736a7afc0aa62f2cda5bde998f52a80b1a05eb5b6d2b2fac429d954b5",
      "text": "What you'll learn",
      "hash": "1c1710e31c7cf7c4421ebf663e9209d95ec55b980e98f279320019664bbd157e"
    },
    {
      "id": "f5d310cc04e0ea5812458b97afdc32f6b96c019fb44af8e5bc23b6c05da14f14",
