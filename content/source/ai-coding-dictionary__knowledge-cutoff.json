      "hash": "2330131b5d9793d4023783aeceb087c7880f12ec9aeb2d9334466709764226a3"
    },
    {
      "id": "45cbe4c050db8024f08dcef15762c944cd4da83c9264d88ab1481581581208ce",
      "text": "Knowledge cutoff",
      "hash": "da7752dcbdc5ec6cb75299abd8a5293085358a207b7a1383db9e1ce36002d71f"
    },
    {
      "id": "04116ff1aece12e5720c6c53dc334a597df143136104a01009c16d34f4cd503d",
      "text": "The date past which a model has no parametric knowledge. Post-cutoff libraries and APIs are fabrication traps unless docs are loaded.",
      "hash": "87a9269ed198acdfd6e7aac285725b4ae882c13628113a10ab64fa3778efa089"
    },
    {
      "id": "f4e0f763d901c55ef4b8a965f1d5a2891013ea7296256f1d66b0f45111674c52",
      "text": "Matt Pocock",
      "hash": "2fe2c13509fbd45ec2578a74ef8efda313caad4f19533a102ca7d666ed60881d"
    },
    {
      "id": "85859173202c2ceaa26cd32800179c07ffe44422598626da1f0aa05b150b952c",
      "text": "Copy page",
      "hash": "4104018941ae3ab016c117887a91b4f933f28e36c587b8983373fe9377ce34d7"
    },
    {
      "id": "ba4517d9b71e5c74e148498c5dc079f797937ef232bfd9c5977a39508136542e",
      "text": "The date past which a",
      "hash": "5efd167805aabb319b7b9493390f77d6ee6e9cdca47b3e3af4eee81f0d469a8e"
    },
    {
      "id": "1ee67c59f06442e4dc4f1420b9aa524a86dc0259a0a71984111385dd65520114",
      "text": "has no",
      "hash": "fceb1ce1e7640d6ea930d5a1fa8f64d6bb3e43d07d55eb4e99ac937b2447069f"
    },
    {
      "id": "9ee114f46df58865c145aa038d2faf7e9d75a6ae9a97a4c4d4b079ec8c078b6d",
      "text": "parametric knowledge",
      "hash": "af45e8f3199438ecb8e32a5842d362c9e1486e34f1b2d9374b547824e0ceb837"
    },
    {
      "id": "c6532b9c07328fcc7c8f1a81654cc4fc15ee6621e0f90009323868c25165793b",
      "text": ". Libraries, APIs, and events from after the cutoff are fabrication traps unless their docs are loaded as",
      "hash": "ef37f4f3921ff6c1377f16270cb5719439346cdf1d23e507450907a9350b464d"
    },
    {
      "id": "dc0ac79ba780768564480293c52c1434658a400f8ae0c9061029798305959ae5",
      "text": "contextual knowledge",
      "hash": "c5c07eb508c755a6fe9f4ee4c829877582a9a819c31c8bb16c552c305ddd9600"
    },
    {
      "id": "1166ad2b7dc5b75cd3ed8a90496b8d7ffc12aaa2fabd30c4831944a6177bd4a5",
      "text": ". Each model release ships with its own cutoff.",
      "hash": "b760b65534fffc6d7fe1fc239b6d4dd31f72f76afdfd6c3d499b8bf194d44fdd"
    },
    {
      "id": "e1157c3de4972bf2729449be46aba40f75d78260daafa511b6bf6c34ff9e495c",
      "text": "The cutoff exists because of how models are made:",
      "hash": "99493ad28c2c0d4023e79fed06a8b94e92ca2bce52741db3a8caf87d30dd8bc9"
    },
    {
      "id": "37d16a66e1f80a3fe0caa918e7d1cfdde2be4158b6588252642c8d5c1415d1ab",
      "text": "bakes a snapshot of text into the model's",
      "hash": "3d8bb8720abc6314f8dbb7618c43b1887f0c76c47ee4a9414d3122a6302d1758"
    },
    {
      "id": "c232aa2dc40a552a0f8bbd741922502d3bf66bf1f48b51fa28965a63e45137ba",
      "text": ", and after that the parameters are frozen. The model doesn't know its knowledge has an edge — asked about something past the cutoff, it doesn't refuse, it extrapolates from the nearest thing it does know. That's what makes the trap quiet: code written against an old version of a library looks plausible, often compiles, and fails on the parts that changed.",
      "hash": "eeecdd0a83e87f6c32bc00c044672046cd77cfef2d1f7065f29c3b3021011407"
    },
    {
      "id": "2a7975ed56dc17d572ee82ec8bc46d08734ea7796f4ab090d69eb9c97aaddcf3",
      "text": "The fix is always the same: get current information into",
      "hash": "599ffaaa40d42f42d778cd25d5898b62240453a2b25a202c8643f5f3e8a6e337"
    },
    {
      "id": "e2bf83ba133a3ed5ba5b4c215791845184090e923005e2ca716560e5ce881537",
      "text": ". Load the changelog, point at the installed version's type definitions, or have the agent read the docs from the web. Anything in context outranks nothing-in-parameters.",
      "hash": "4f090d4f536130b7266c3afbb112789574d1a8cac3b835c74cae24de5760e756"
    },
    {
      "id": "5604a73aad9bbba95e0ae3e75534ee4d08f2e3b414b58419816a6605af613797",
      "text": "Usage:",
      "hash": "2bad3eeaf33caffe3bc9b482b4934ed19eb4ec3614c12373e1a5c5f8948217da"
    },
    {
      "id": "a5f4c827a0889a650f00746ef2ece867d3819b6821ed1815643d97a801eb0d75",
      "text": "\"It keeps writing the v3 SDK syntax — we're on v5.\"",
      "hash": "b16de9fffde4e7c192d3b685ca96c313eac754eeb493c4c64ae1551208882c7a"
    },
    {
      "id": "183472bbc9046a06ebd0fde6f02b8efc4570e905edd81f7e8204245eab1911ca",
      "text": "\"v5 shipped after the knowledge cutoff. Load the v5 changelog as contextual knowledge, otherwise it'll keep fabricating from the older parametric version.\"",
      "hash": "c37d3fe8511bbd4a83d3fc931b2a92e6dbc91e23f751a0581a125ff646d53f47"
    },
    {
      "id": "5cf31e9dd3988f6bcf94d8b71da9769916708868c2f3223393664c886339e8a1",
      "text": "Previous term",
      "hash": "735604aff9e8f2192b83df4905cfc8e395613e0ce05f8ca85a1d2d1d44fd59f3"
    },
    {
      "id": "f73bb4c5822a8cb9009885948bacb613c72e62f9992d7f194bb707277253e288",
      "text": "Parametric knowledge",
      "hash": "ca4427e58e7eb25fb52c817968346f4b0283569955f17477e050362e47238167"
    },
    {
      "id": "524103b7ccebe8b617673ecee060a6549833de77a5771f730c92e81ad593610c",
