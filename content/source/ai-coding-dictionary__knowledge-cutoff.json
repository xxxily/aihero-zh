    },
    {
      "id": "61bc108cd5c1e171c77c3cbe798abfeca87819ebc5002cade6bc9e55fd852713",
      "text": "Contextual knowledge",
      "hash": "d6e7abe0383292e093bb86c7be9c6e2a5572caca8fa0e5265c6f14c196b0bd4f"
    },
    {
