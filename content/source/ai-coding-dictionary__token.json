    {
      "id": "b7c82b43c5b06a9fd383dbc0047031cbf13bf1adbfc374192826594c015e0aa4",
      "text": "FAQ",
      "hash": "dbc468a14b601d5d9240aeb72b9fcd2f8aed2f4e30932876edf8d16ec313846b"
    },
    {
      "id": "136388af1d75c97f8453e5fbfcafbb9af1752e24389e46bbeb190c06f6e842db",
      "text": "Terms",
      "hash": "ede5489964834a514b61c7a4a8370be2452dd4a7d807180f14991ccc11ad2430"
    },
