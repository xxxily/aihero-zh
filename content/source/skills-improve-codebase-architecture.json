      "hash": "1bc3add9114cd43052231f1a226921808bb9b8dee191ce4eddeb65078509f15b"
    },
    {
      "id": "db9db9a59f31bd685255ee977b7b7e6c2601edd4132f69d14a7af87938149ed9",
      "text": "Find the modules worth refactoring, as a visual report.",
      "hash": "e68f7f37b834194faceb91a5decd54e183228e21ce907c7fc6f4f1957d2b0885"
    },
    {
      "id": "c56097466b6c10da3a5a6022768fe71161d40e155ecc6eea6a8d32fdd5490da1",
      "text": "Matt Pocock",
      "hash": "2fe2c13509fbd45ec2578a74ef8efda313caad4f19533a102ca7d666ed60881d"
    },
    {
      "id": "6e3276b105dc64088d90ebaa56e873037f3dd95cef6ec9a5c10ccd4bc1000ac4",
      "text": "Subscribe",
      "hash": "cc0e38da9c41790bffef1b88af32d39ac285edce93da766810edc237cb2f1625"
