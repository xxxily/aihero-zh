      "hash": "e22820fcf5cd90e3fdd99a7569e0ee2f30eb7ebadfb2fe4d159b30c166ff81b7"
    },
    {
      "id": "79bfe7190f8228fc2620dfa96649d7f72e624e1f47fb6306c8880642330d5a13",
      "text": "02 / 07",
      "hash": "0ba6b19c6766eee683b7276d890c5acb747958960ed7b467f8d6de8bacf964b2"
    },
    {
      "id": "48d348c12d2141500de383193ba94e5f8296cf27d9554028d6c463474780398b",
      "text": "The AI Engineer Roadmap",
      "hash": "0ecca41f97662f50fc4210f00b4d05ed73257d862ecbd642b906cd7da42d4092"
    },
    {
      "id": "25c4a4bf7b4a05622e8cf47c639849462cb68917ea55a91987df5a6fc2426e37",
      "text": "Discover when to use LLMs for data tasks like structuring and classification, and when to opt for deterministic systems.",
      "hash": "cc535db479f82807922e33f68f7f1fe03f1062466deab59986be029bbedc8adf"
    },
    {
