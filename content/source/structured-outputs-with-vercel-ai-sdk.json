    {
      "id": "0f08948981fdb1104f71af8f80276542a778524807aa97fd34f98b93c3fdf8f2",
      "text": "08 / 16",
      "hash": "88c997cb2685e3c58e84662d392025c58dbede12c492d575bf357453e71bbaaf"
    },
    {
      "id": "8de96ba81e8288369a0ca0f50ea0e6c98badc841f3999d8a83b7089c3ae8a988",
      "text": "Discover how to use Vercel's AI SDK for structured outputs with OpenAI, focusing on efficient data retrieval in predefined formats.",
      "hash": "1fbcb03b242d85e4fb61f81825d262d16fbc5a535924666cb157c1638a24e7af"
    },
    {
