    {
      "id": "3669ad034be1a81ef1587f5bb3bbce040b2a8e5b3269a2dcc162938d846b46e3",
      "text": "04 / 05",
      "hash": "ca0f1a4359e45b722806a62bb75a03a854c069c587315c23140748952056745c"
    },
    {
      "id": "089e4fd84f449b6995402f9918b5ba2b7006bef5f96316f1ec72d1fd9c2eb098",
      "text": "Discover how LLM tools enhance AI capabilities by defining, choosing, and executing tasks via system prompts.",
      "hash": "2f5e40f09ca9c36cfb5edcc7f844bdc73738b64bb7c75d0a422c04cb064e6abd"
    },
    {
      "id": "207fb55fc9234ff7d362e059ca8ee20ffe0a6c6bb69b0dc6bf5bffe91352bdc5",
      "text": "Matt Pocock",
      "hash": "2fe2c13509fbd45ec2578a74ef8efda313caad4f19533a102ca7d666ed60881d"
    },
    {
      "id": "b41da0f8c5f75554484deb5564870b1f141f41416d2be99140208ab610c59aba",
