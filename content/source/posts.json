      "text": "Skill-changelog · Aug 5, 2026",
      "hash": "8dffef024cb2e2ba2dab8e8b4ad478a297943d1f636c4437710f7bc3cdeae5c4"
    },
    {
      "id": "09a0a1cdbece82e4606e60246267cf162ee59f463545d107be9543a79ca7840e",
      "text": "v1.2: /wait-what, /writing-for-agents, Claude Code Plugin, and more",
      "hash": "7855995cd8dd8160228dde5a165301055a832f9979e382172c2b50afa51dc5e0"
    },
    {
      "id": "23324dd842f596a40cff56b2c65a3b01901e0bfd3357cd71b4ec9a7011ac7219",
      "text": "Explore Matt Pocock's Skills v1.2.0: new documentation, Claude Code integration, the Wait What skill for Opus verbosity, and more.",
      "hash": "be96e8fcb29728d0616ce45cd435dc5c57e2724c4edde0c141de6659491abb1f"
    },
    {
      "id": "53ecef218aaec2e68588383f374d9c258004502adb7f51121a4fb18599e61e1e",
      "text": "Article",
      "hash": "29d94922512b93e8d81ffb4c721e52afd32e80d952ebe753ea2b739159219dab"
    },
    {
      "id": "db9970552f36780ed5fab333b73dc1c936ec4850ebb2ff3724e61ae81de2ef8e",
      "text": "Article · Aug 5, 2026",
      "hash": "527ac00200dad0954c084a932455c6eea1d6a7e15b5926a58cf336d812683a14"
    },
    {
      "id": "ac30f46d1189865e15944b0ed0e6a308d091acf64c6df263d7a8bcdd41915865",
      "text": "The /wizard Skill",
      "hash": "dc2a9dfb2e7aafb5b920a374d3edfadca9df74126313b2f8bbd9533e45a3805a"
    },
    {
      "id": "9449cf4832d8ee619a90609949f44fde1a5f7641a0dc2f79ae0d276d802e832d",
      "text": "Generate a script that walks a human through setup.",
      "hash": "f8695bcf2f281865859b895a96a161f3668bf098e70bf9fa90e8897e23590a0c"
    },
    {
      "id": "ad0a1f5816b4fee25a82d0b85cd836870721096f7476522e2e215464ffce707c",
      "text": "The /to-questionnaire Skill",
      "hash": "3830a182a5231fe3723288a956ef6fc920624202c591cb8eccfc4631443da29d"
    },
    {
      "id": "747752d3dec6d7393e5c7148727d2e65f1e30856995e4c4e776b635c80340366",
      "text": "Turn open questions into a doc someone else fills in.",
      "hash": "deb0394f9bc882ce7315d608a1ce70722ab9b53bfa5b88694540a5c88594ca0a"
    },
    {
      "id": "2da526ce5b66adfc08ee56121f81ac8b6f720f56646047fe6be952f48bc84876",
      "text": "Skill",
      "hash": "6df1bb18a59ab97df82e307b93fe4f3bbda34d531bcbb79ec573dda23ba64918"
    },
    {
      "id": "0198f9acd4ca0f48896e543a2c85b8eedeff7908e44d2ce283628ad8ed25efd6",
      "text": "Skill · Aug 5, 2026",
      "hash": "a0f70fee001e05d7ff1086e6af2b5ed286a812f97331a18644f7ea405e591ad2"
    },
    {
      "id": "0de5d3345de1d394962e19e45ad492829c6ae89bb68b12814695d0a59f15620a",
      "text": "The /wait-what Skill",
      "hash": "e6bdcc6683fd9e297ee57882e5d2370d26e6fff3b9b03bd528804cfa7ad01fcf"
    },
    {
      "id": "2e9dcfbd0c1860720e9e40e8f91a99f5e8fdebdb4201753b66618879034e25e6",
      "text": "Ask the agent to say that again, in plain English.",
      "hash": "f97ef98c98295b553e6307da02b88fd340d206924528abab09a08aa495568032"
    },
    {
      "id": "dc611e0d17fc07f066cfff480d03c0d64563355d4aa42a6c7dee2214f2fec832",
      "text": "Skill-changelog · Jul 8, 2026",
      "hash": "fbcaad0a5c0071a67784f4ed3cfe4ff9ff9917a082895fae0f89541062cce3e5"
    },
    {
      "id": "2c493e2e2b5363b75e40d20363ca0b5d8a7be534db0bf7f831601acbd0c0a20c",
      "text": "v1.1: /wayfinder, /to-spec, /to-tickets, /grilling improvements, and much more",
      "hash": "3b71808eca0626a0344f2db4e04b077d0170c41eab8e31ba3b09acb11b195743"
    },
    {
      "id": "4deadff033acba02de48ca60bff7cea346ae94d128b2e457d5cc4555bb9c81c7",
      "text": "Skills v1.1 released: Learn new agent skills for AI coding including Wayfinder for planning, spec improvements, and TDD refactoring.",
      "hash": "1f93e2a57fdcb20d59138aeba5e6b3800aa616b7c00026186ebc7e4b369df7af"
    },
    {
      "id": "2411e8753a170d29cd9c499f7da814fd4a409b6c8fe3ca44bd0302d9d319213c",
      "text": "Skill · Jul 7, 2026",
      "hash": "c74bcb007fe5a2baefb6f29bd302a3959e69e7b25a1628e785b7b603e635dd40"
    },
    {
      "id": "f69e8173c5dff1e9202b6a9ea818d106e628b1f2a04cbcd67680ba3fb02ff520",
      "text": "The /writing-for-agents Skill",
      "hash": "f022e2398dea44aec218f90928e961973c7eaa03026792434aebd61ba6c18cfb"
    },
    {
      "id": "de5f9336882cb1c47880cfeb68591f544806258d1002fea6dd038269b3cb1f4a",
      "text": "How to write skills and other documents agents read.",
      "hash": "d41c389a7a27425782655e56c3509c48ff3d87fe630423fc24608b959f19b477"
    },
    {
      "id": "e59fca791be123e534309d1a8f7e79799e1fdfd0e2be81fb8b821ac9da4fc41c",
      "text": "The /teach Skill",
      "hash": "3eb25da61522976d76351eb1e464adf19c3c6b07956a325549bd111789da85c1"
    },
    {
      "id": "640b02e4981143469637299efa731511b6bba2836e2859f18d0b84aeacd14139",
      "text": "Learn a topic across many sessions that build on each other.",
      "hash": "f68ce258bf643b4a5cf185bb389147450aa13df3da709f20dde866f0012da4ad"
    },
    {
      "id": "96d19f70920288cda08d8d2a3c96974b17ed6870ab7e305ba8dd8a11050460cf",
      "text": "The /grilling Skill",
      "hash": "c50755e0e84e83e16e02220d20cbb10f02ac6375a744957c5480bf0b0ae7afbb"
    },
    {
      "id": "04ad9dcf89886eca3c0e8231f1990295d6015a5245f2e63d5e1d17083fe8dd5f",
      "text": "The interview other skills run to stress-test a plan.",
      "hash": "95e3e7298316f4eb765ab4036f6b3feb4d47ab9b50ea518cda56e42f6a046b24"
    },
    {
      "id": "605ffd21d3f136e98293844b38701d49c4b054779883fdf6f7b15c7258cd3254",
      "text": "The /wayfinder Skill",
      "hash": "ad5c81cc0127099d818f2a0d357323e62abb1458a56b2b704db6d50303313c48"
    },
    {
      "id": "e91858afe285b36ea2753ea4f60874110dc6c6db8914b251b11cef7be729acfe",
      "text": "Chart a large effort as a map of decisions, and settle them.",
      "hash": "9b26c847f92a26cc850b923ad33198bed591f0d2303cc2aa584c46f35b0b2b73"
    },
    {
      "id": "2bcdb9342e15550fe81140ee741a21472921772806c1a067490cb12de2594149",
      "text": "The /triage Skill",
      "hash": "28ca8c73ddb7e7f15619f62dd65f987942e6e4a625b9bcc743e938d3322893ef"
    },
    {
      "id": "884c4eaf40dde8fa819601070c81afb3d540f94a1ef499cdeed16c3aea62891e",
      "text": "Sort raw issues into work someone can pick up.",
      "hash": "e6bd65a2d22d54b2d388915bd6cb13c5b9ec92ceb47864c56f2d77d30ee3e067"
    },
    {
      "id": "8fc9351b1b7e3783c8e0b332a3ad5401842107b1c0b6d69c535c4449326cd917",
      "text": "The /setup-matt-pocock-skills Skill",
      "hash": "0674a6df3e473a2f50336ebb738940e032a1a9c5a21617f3a639eccd99c69b49"
    },
    {
      "id": "bb839f77ac3496dfa949bd38d96f59ceb2fc62d95f2d3918e8260fdc53921bd7",
      "text": "Set up one repo so the other skills know how it works.",
      "hash": "43e7aab494cb34b6e9f7a6b281e62e52bf5898d82737b0520106430ccdc8a78e"
    },
    {
      "id": "0ab435746ae17ab534a754f37ab33607111807a86fddd4db4fa0289ecb840358",
      "text": "The /resolving-merge-conflicts Skill",
      "hash": "503c1d265cd640ce24d1252efc32c21add9fc91cd0c40a7ecf7af547a1f28fd0"
    },
    {
      "id": "5389903097e133621287635e3a429d1c5fc659f28fc4cca37de0eaf42421cc60",
      "text": "Finish a merge or rebase conflict, hunk by hunk.",
      "hash": "f0a2531ad701741352b3d7c996df8522dfae50698ebeff40d771a35d0f768fec"
    },
    {
      "id": "4914a786b27a1a4e8988196ad2336cc5665f69b19f01456fd2bb376afe4c61c1",
      "text": "The /implement Skill",
      "hash": "f9c16f5a43a4bc3ee3005e2fe35c9f995067f243d46c0e304c68ca35fc366358"
    },
    {
      "id": "f65a09937d0a78ad5dbeaed280fc50bff28a998a967ad085194bca551abfde65",
      "text": "Build a finished spec into code, test-first.",
      "hash": "17c81dd1b6d0fe3f9916834f8da1797bc90e00e8c13a04c5e5ea075df068295e"
    },
    {
      "id": "b3e50c242e6ec70663eedd763fe9fccd02acf4400e0c2cf3224480ab0dbde8f0",
      "text": "The /grill-with-docs Skill",
      "hash": "5d7a7a42b472b35c9a5e2adae6230bf8e98d261994d05596e68436cd90d8e6ee"
    },
    {
      "id": "e0bf1242e2a42478d6861e07af2d84d96d1c775e2ad98c0b0f2c11908eb97b52",
      "text": "Get interviewed about a plan, and record the decisions.",
      "hash": "e0613e7faf7d5debd6ba99e4d64d86953a6440666da603540e579ed0d5ba6e4a"
    },
    {
      "id": "b8704a4324917286046e4f3375f5db1c87533e0de07082d1110651c1b7bce946",
      "text": "The /domain-modeling Skill",
      "hash": "f616ad2f4b341b188201e3bffd4995711ab6ed10305f53e7830d2ca72690ed70"
    },
    {
      "id": "a12f469f0d09dd88f9304143edc9b24425fd9183d6f618baa4e1d00cdd28ac44",
      "text": "Sharpen the words a project uses, and write them down.",
      "hash": "999bf23db2c00b8722516f86a422ce6d94f653a20bce304cf8117203f93dd91b"
    },
    {
      "id": "041a8378c688e49803f4024e15512df886956d20944ac17a730a74fd13ddf576",
      "text": "The /diagnosing-bugs Skill",
      "hash": "82d22e5c3f7a145e0c607c7003a935a563d1e107a030000f3aa33cbcb8f1f676"
    },
    {
      "id": "13a1c76d99d269f3c948c81f1dc0e05fd4a0f55176cc097f3fe0896df487077f",
      "text": "Diagnose a hard bug, starting from a repro that fails.",
      "hash": "06a7fabf29ccfc91b67039ea29118eb89146a7a5ff46a87b6c1a85510c7c2eae"
    },
    {
      "id": "d96649e121c792ee9c79e0118acf2033760741e4854aadae100c6034d305d008",
      "text": "The /codebase-design Skill",
      "hash": "51bb7c310f0738596f89fd052f1aad809c7bf9022eda80f5040c899abf348c99"
    },
    {
      "id": "5661471846553c813fb4767ef2730d8219619b4ad11a7bbbafd105bc887dca3f",
      "text": "The vocabulary for designing deep modules.",
      "hash": "5bf30d95f6dfd104381cf84adc51103005c5b0af9de518fa3f59bae5b080bcd9"
    },
    {
      "id": "b3fa831ae7b52f263e01b4aa9f4764f86e3da25645c2419bea0805ea170b1af3",
      "text": "The /code-review Skill",
      "hash": "828cf257382b4e1a77ee8dbdd85ef159141d8c34e4942831831d4f70f5ee84e8"
    },
    {
      "id": "ef9729f1489bcfe9a8469cd19ac510f632a91829ffc46d98b75f591c96a84376",
      "text": "Review a diff against your standards and against the spec.",
      "hash": "989b04edac7564ca86e6e4b8c4dc81b9c0f10293b9dca4ad2269fc3a027f2414"
    },
    {
      "id": "6975bf8dbe282fe86edb24216a93b55ca93a347dc718ad450ea367cf30aa2124",
      "text": "The /ask-matt Skill",
      "hash": "e33293398b90952072fe7083e0cff6ee94d84e49d6ed9c02486551ec483ab2a1"
    },
    {
      "id": "05a4a379cbd0978d3280b887ff0861e30029fe4c017d1048a1dd9d3d4a922379",
      "text": "Find out which skill to use for the situation you are in.",
      "hash": "e7a2a8ffa79450713b534c7006b5b5a83146beb7b5ca92b0e9f5274bc3acae66"
    },
    {
      "id": "70e168f3cf0c56889b25687844a685eb5bb840b00518c99d4f7ebadc0defa584",
      "text": "The /research Skill",
      "hash": "d44fca1fd1a3bf52e4677b6e3793c990ea7f8b12508f0fe03d7bc328c60ad562"
    },
    {
      "id": "953d585087b14b60115166fc9ebccf268642431fa1ed7d87ec9768ca8e98299d",
      "text": "Get a cited answer, read from primary sources.",
      "hash": "8729edd445e908272061a117df0331369ced9bb9953c13740aac5c062166b2d5"
    },
    {
      "id": "fcbedbb94415e58493af45d892ec7d335d1c3d23823b904633996c787848e929",
      "text": "Article · Jul 7, 2026",
      "hash": "d5f1c6065a0661f282ad48e0cb647655275f7a54d689ac7f26766a3be51073cc"
    },
    {
      "id": "63b39e21d7828cd435dba5f4929fa6515a600d4e18533f3bc77add2adca3afd8",
      "text": "How To Kill The Bloat In Claude Code's System Prompt",
      "hash": "5eac9e5a312a96c69fd9db284f014acaa848ba97a6d1604e82adc50188d9d0f6"
    },
    {
      "id": "82e2d6a7d7b7a3d3cf9f8da586760addc381f5077b70adad5b6ac2f13ee7ea7c",
      "text": "Skill-changelog · Jun 18, 2026",
      "hash": "904853cbdc48af61853556824572421a0975b38d0452807d1ac8f80f1848b13c"
    },
    {
      "id": "7eb3afe2ede2614cab192019001c742dc04d42e943dd48aaf1df88e5134569dd",
      "text": "v1: 63% Token Reduction, /ask-matt, /writing-great-skills",
      "hash": "0e257aef4ba32b497a98e46415b02574c23239d3a9a6410978ab8076de4caac6"
    },
    {
      "id": "85cfa7c2a436462328a1d5ab71693dcc6b4a8c2ba9c459eca0479bcc9a7a46d9",
      "text": "Skills v1.0 update: 63% token reduction, new routing skills, domain modeling & codebase design. Install with npx now.",
      "hash": "92a7010fb2daf0d545672301fdb2f2356b0ccd4c031e5aaa80d20b20a579c7d8"
