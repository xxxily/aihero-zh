    },
    {
      "id": "5ab8ddcf73f8c6223f40887099432caea77dcb89d64d47c86a91c71a9de789e0",
      "text": "AI Coding Dictionary",
      "hash": "4def77f9388809f53620144510fcc4b6f08662617bcc06a15abc618242e6544c"
    },
    {
      "id": "52f694ba7f03b7b412fb0c1ed86a9473bcafbc7eec2bdca97b73603d30e367b8",
      "text": "Topics",
      "hash": "e22820fcf5cd90e3fdd99a7569e0ee2f30eb7ebadfb2fe4d159b30c166ff81b7"
    },
    {
      "id": "58b96d578808683c698443e6cfaca84ee0157619cb5f2f762f5a52730f06af20",
      "text": "Sessions, Context Windows & Turns",
      "hash": "6ba86329848f193a00922dde232ac1e483d8805be061a48f5580560ee54d0b69"
    },
    {
      "id": "6e14c08c932d443f1687aa40c53609891ebd31bdf37b98341e25b0e1d731b920",
      "text": "Stateless",
      "hash": "f0916a93b0a1776f11d26f8ea012555868465f41131bb6037f712455ac330788"
    },
    {
      "id": "f891d023122ae0aa91f72b3dda965642e566c3abfe11a50c95c95ddb43d48f8d",
      "text": "Carries no information forward. The model is stateless across requests; an agent is stateless across sessions by default.",
      "hash": "ae8dae879a652102f3eee96d71327fd4cda6c6072e0517d7ed504dfbd94b91df"
    },
    {
      "id": "12b33ef074c8ed91e59fe555f10ea1552ba0612c4f337cb46403d29d9d4f71f7",
      "text": "Matt Pocock",
      "hash": "2fe2c13509fbd45ec2578a74ef8efda313caad4f19533a102ca7d666ed60881d"
    },
    {
      "id": "28915b92a5fa1aafeb339b9156bcc45f3ca78f509f5a6db7a7cfc9ec7548c2a7",
      "text": "Copy page",
      "hash": "4104018941ae3ab016c117887a91b4f933f28e36c587b8983373fe9377ce34d7"
    },
    {
      "id": "ac5347d6228ede8e99be34fbf90eb4eb6da8c2ecac888be7f154cf6749f331b2",
      "text": "Carries no information forward. The",
      "hash": "86689d47adb885bc0741b86b98d3fd8143e2d07d0603fcd1e4989e05e7870f4b"
    },
    {
      "id": "1e327c491c54fc3cceb18ed6624fd08bb56490b2afdd57f03c62534619326c39",
      "text": "is stateless across",
      "hash": "79e5e5a4f83c61fd4470d08032a652ec482389959fea3af04e3a12e782e8f05d"
    },
    {
      "id": "531780944cbd06d92e5c27f045d2ce470f8d958dc74ef4d86c1021f7a26a85f6",
      "text": "model provider requests",
      "hash": "08d711616fef85ef9059cc46b7a84267d6c19dfaee59ccad9095e7d25528b21c"
    },
    {
      "id": "af430f40e8f4e5caa4b96ae855949cf9d39f5ab4ef76eca577fe26dcce41f106",
      "text": "— each request resends the full",
      "hash": "2e8abb2f64993f518b7b675b1cb7058a4b177488826c40711a0cf0ad13cf5057"
    },
    {
      "id": "28b984dd9dbc99ba87ed12f374599034c6676c4617122c2ae3b9560ff2df68a3",
      "text": "context window",
      "hash": "6764434518d37f01df452fe2af0af3f314f8c27a72519001ea14189c5ee42476"
    },
    {
      "id": "76b70d07a4fad4a9025de2af5aefae1c0694fb3269408083aecf23e0a6264065",
      "text": ", because the model has no way to see anything else. An",
      "hash": "18fab6e43b7d7506f74a9c6fbcf96e3be3827fdedf8d3290e6ea38ea032b80e4"
    },
    {
      "id": "0dd2b3d4f9502134fd26fe5ef74993ba51e4f50e0e916c807e2e74d0c3e4cdc8",
      "text": "by default: a new session starts empty, with no trace of prior ones. Counterpart to",
      "hash": "3c7a2361ae35b5432d73cd9dc2350447ce4dabaa99cdd36aefce5bc2d12e83fd"
    },
    {
      "id": "a47e087c5de6172a3b54bd28b0ee2fc050d9429f0d8010c3f37fc659eb30280b",
      "text": "The model itself is permanently stateless: its",
      "hash": "7aaf1fb957b5eadfd74d6d6299d4f6c3ff95529f9551f7afb96189b2eda1842b"
    },
    {
      "id": "ad82dcf8acc8baf43186f352340f98e957bb27c5f065576d660f21e9ff77bf6d",
      "text": "are frozen after",
      "hash": "98710ea75a001c51145b2b3c1bdccb5f1aba86be8d99c9a2ded4a7a752976ab5"
    },
    {
      "id": "61ae89a454c505c6f259954fc36f84465e113d2b8bd1527790ca837f6eba2885",
      "text": ", and nothing you do at",
      "hash": "7225b163203edf828d9a71ceb8371a02c6d55d9843a7d1fe3a675b867dc60fe1"
    },
    {
      "id": "f4a37d5ee939240a1b9695debab3732641829fd9c4583ccf399628cfba06de1b",
      "text": "changes them. The model doesn't learn from your corrections, doesn't remember being told the same thing yesterday, and isn't getting to know you — however much the conversation feels otherwise. The feeling of continuity within a session is manufactured by the",
      "hash": "f9ec7005c91015bfd60de64f7bf7a3c816e73f55a3491da7a78876bfc40e9591"
    },
    {
      "id": "86df7bf906f2d5091f614bacacefc8d0c3ad348a4c65c81b0660f55bc9695acf",
      "text": ", which keeps the transcript and re-sends it with every request. The model isn't remembering the conversation; it's re-reading it.",
      "hash": "66056c3c3b1d6fdb33c71937f726502d03d1975a0a1d05f584335e41e127dc9c"
    },
    {
      "id": "12087b5dc3b86e0518faa2c3e9083e4a9fb354017e2252d02a20e5bdeabcdcb0",
      "text": "The practical consequence: if you want something remembered across sessions, you have to write it down somewhere the agent will read it back. That's what",
      "hash": "bcfcac0fa2a937bc91fa6ce7fc722d3d70ac5b4e6c2468bd0ace230235d7086f"
    },
    {
      "id": "89a7d21c7be8231baa626767b112f016b61274ab9fd19b62a0d92fd8816bcd47",
      "text": "files,",
      "hash": "7cf46d84e3704b306b10cb7cd4c58562f637eb35e84f2c7bf7763e40f67c0d84"
    },
    {
      "id": "58d17d820fdc870bc67aa9a2de635c09cfd4b922771e786bef2d350047644acd",
      "text": "memory systems",
      "hash": "8699aeec0f58f0cf15c1e661971b31bf6a9663656c19f558ef1a1450599d15ce"
    },
    {
      "id": "ca419b30e97e7f0d9ecd0c47696d50a01b88e6e00fb988acc4451ff77c578ce2",
      "text": ", and",
      "hash": "4aa9bfd2f175a94ad5a7cb321e1aea9790c73eb366a3415b47a00aeaa9fbf24a"
    },
    {
      "id": "714c79e0283fae1c70ce434863a2be0a80460be7c842d77f63f16492c6dcb4ab",
      "text": "handoff artifacts",
      "hash": "78a3516549d7b8e8a934563d52ab8e83d5f2048f1c372864042ed720577ba58b"
    },
    {
      "id": "e30728a95c67384c8921e2b8ec66de8a99ac2d662b40465eb560fd6927680ecc",
      "text": "are — files that get loaded into the",
      "hash": "10a3d1acbd3841444642c9964e9c722abd259cb6b6288333b17b2e4892402b2a"
    },
    {
      "id": "5c475329155239277221c4b863987c40816b881a2c707748544c1be47ab4b3de",
      "text": "of future sessions, standing in for the memory the model doesn't have. When the agent keeps making a mistake you've corrected before, the question isn't why it didn't learn — it can't — but where that correction should be written down so every future session reads it.",
      "hash": "e6ca57f92467cfd870eb85670e288e5b75107c0a0d24fd2132baee9dd683158a"
    },
    {
      "id": "1844928dedc2d13c6b53d3d13a7163ca73acd83b88fa15c0a2a36a20e39857c6",
      "text": "Usage:",
      "hash": "2bad3eeaf33caffe3bc9b482b4934ed19eb4ec3614c12373e1a5c5f8948217da"
    },
    {
      "id": "4d274ad116aca8067bedb99f29703cb788e8af71b9774cae50de8a848fd30bf8",
      "text": "\"Why does it forget the convention every time I",
      "hash": "4e4d8d9e4bc2c65fee68a2a5198d100c0ba7911cd6c3d9998db28d9df1ad20c0"
    },
    {
      "id": "88ffdb278ef432e1d02bf68c528017faa850f710d92983ac96eeb49b77077bc7",
      "text": "?\"",
      "hash": "19ea93571d24c1b4a75edb5927269424f305db383b5b4fa0cb71a74252ad701a"
    },
    {
      "id": "4886793122ef2df372126ca7ab90b093dc49be387e5f148d3b47de2970ed6b64",
      "text": "\"The model's stateless — the new session starts empty. If you want it carried, write it to AGENTS.md or a memory file the harness loads at session start.\"",
      "hash": "960e0f85ddf36cd18fd31f46769ce8522a303a6226067edc5aca168baaf07401"
    },
    {
      "id": "d4ab963cef14cbc960ff96a6e92577795d9775f5f21781f766331a044196f9da",
      "text": "Previous term",
      "hash": "735604aff9e8f2192b83df4905cfc8e395613e0ce05f8ca85a1d2d1d44fd59f3"
    },
    {
      "id": "0916da21304ea30a98ce401549d092ff343dc59330598527fdad4db19dad3147",
      "text": "Cache tokens",
      "hash": "cce47e61662627e3233cc32f7d9c15df14bdb29e105265edb1add04660d4dc43"
    },
    {
      "id": "5e5660d8f824ab8f89fe1b46d8308eace2d7edbf5dae4a9705070fcc7e214dce",
      "text": "Next term",
      "hash": "5219c7ebdc0e098aa6db6f09e405c1b17ab75f1082862906a872e10a16818f9e"
    },
    {
      "id": "1a88fbeee6841d40bc301149d095e1422e6ca48b0c7f91d617dc2ef8822e1840",
      "text": "Context",
      "hash": "a6e600a10fede40f648be37a700467776215ed2da3c271e9d02fa2987190a0a0"
    },
    {
      "id": "3ee998a39d74548a1d635778c1e5f5ab8327c3ad726785acb8532d6c785923d4",
      "text": "Want more than vocabulary?",
      "hash": "5d5500a083006a1606e84a03c018904d01364631c6baea4c7a3f8f3f62bf94dc"
    },
    {
      "id": "fe66abf1f3867953c1c0cd1ffb7ddec8a36789ab6d2c172b60920e1af1a446c6",
      "text": "Join AI Hero for practical skills, thinking on AI engineering, and resources that keep you ahead of the curve.",
      "hash": "a082f7147e30da6afe92268d5668a530edfff13e64934f8f63f22c098db86133"
    },
    {
      "id": "792a4be05c5ab95febb541fbffa1a4b5e3db07529f4ebda7a1a07d99125e8247",
      "text": "First Name",
      "hash": "96ce6e6193a047260f5c32aa416d88b6e8959111f43f98457af9cc009a0907ad"
    },
    {
