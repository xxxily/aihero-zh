    {
      "id": "b419df914cdf0c800dd79f70f767bb929326107384a717301e7a5eaf594a08b9",
      "text": "Series · 6 lessons",
      "hash": "67f68e860c0f46bb59b773bf101eee04e81e367faa95465dbec5e3e8db4f6a6e"
    },
    {
      "id": "bc9f1f747728dde134e98f49aff3278e868ecffbf720bd900b6361a674640bc6",
      "text": "The Model Context Protocol is driving a new wave of innovation in the world of AI. In this tutorial, I'll break down everything you need to know to get started.",
      "hash": "ed86522bf4e13dc5facfacdc1c3b782d4a1291f6167986c63b98df27c85366bf"
    },
    {
      "id": "083bf261987965531902cc75f8093f48b63506473f0a8609731c631323ed7efd",
      "text": "Start lesson 1",
      "hash": "4807b65f9294479053540a531b017e8fc8e9abafa633eff06fc9e6f29557bf05"
    },
    {
      "id": "c374256c106380e127ead5329821fc38340bd05b98f6e3fcdb9c3e88c067fbdb",
      "text": "Code",
      "hash": "340f463033e0fd5ddeabb922df4d4f1b5747494d0f5ed9894f13b6e13ca831f5"
    },
    {
      "id": "59f228771cb1e0365c06e71746a0b7e73e7356189f0edb3a69a249759a1de40d",
      "text": "Share",
      "hash": "29887a5ff9846ccc23327565a07e17fa6dcaea6211f1898ae825f84ae38f4223"
    },
    {
      "id": "6b5dbe16d500e1303f1d4e09806395d8217287a934913d6ae06785ce00b4b1e9",
      "text": "Matt Pocock",
      "hash": "2fe2c13509fbd45ec2578a74ef8efda313caad4f19533a102ca7d666ed60881d"
    },
    {
      "id": "9c4dd11634b301635dcdf6fc183ee72e88411123a944f991b24510f69cad68c3",
      "text": "The model context protocol, released by Anthropic, is exploding across the world of AI.",
      "hash": "e9d91b57ec031d1a2b9732772f96ec0dd960bdc6d7c1f11d9701fc46f7519b18"
    },
    {
      "id": "573605070318d2f8c67609dc5f7cd29fb7917521eb462d9d1441a423560427f5",
      "text": "It's",
      "hash": "1d315be944a93f1944421a84f83ce04365bebc1824798f7338ce639423a09547"
    },
    {
      "id": "c304631513dbeb49e3f3888d683d1fe8f5900780f16224d3d68ab1125adf5c9d",
      "text": "the USB-C of AI",
      "hash": "7149a419d0c215f8be78d701da9482b268388c9967a918d3b773a0a2c4677f58"
    },
    {
      "id": "1e2b5bf7e28c75f68a5128e7aab8da35714f6dd1695e975c1fa3b96f371946e6",
      "text": ". It helps link user-facing applications to powerful API's.",
      "hash": "087d98589263d05695c10a91ce2c130a1ce1f0b5f1290c41491566f900cca86f"
    },
    {
      "id": "0df5c57feb689d30248ba385af9ba582aaa099a7e0462f9319d67cc74528a533",
      "text": "Link Cursor to your GitHub account. Link Claude Desktop to your email.",
      "hash": "8507075b98e394b4ee37d003fa78c1b084c4cee20cefff990ce8b03d6009c306"
    },
    {
      "id": "72feddcbd40acf4f9e806289e6eb8fb46166b7d5dc9bbe49ca90e14bb61b0b94",
      "text": "The possibilities are endless",
      "hash": "ec0b657a4812972ff02d256bf001fd8066bbfaa83d8d988cf7fe9f9b961a9bb5"
    },
    {
      "id": "d8248154472f5494f9929e9eccb7f60f8afeb35327094a9576ff8b8224a02a8e",
      "text": "In this tutorial, we'll cover",
      "hash": "954776f834b212ea902032e68a58b26b4415391a5f9c4dac5664ee8fc75e3829"
    },
    {
      "id": "d9c00d9094761f7da7f5527c76afa09d030ae92cecc5c3ec53452c245d27bdb0",
      "text": "everything you need to know to start shipping MCP servers",
      "hash": "3f7471825a9d2911cdb0d99fde3d2aacd8214cedb769323a66b77733a2fde404"
    },
    {
      "id": "9f754e2ec099d25ec8147375a52c31497309d7fd2730b9ca2541726f4b86f0d5",
      "text": "By the end, you will be able to",
      "hash": "d721bb021c98a18bb2a7384857747a8d6b2005ac9484da141e271c4311b4011c"
    },
    {
      "id": "9496334f2db57897df8610d24454aed61a67b4cc173708a9ae06597c4dac13a0",
      "text": "ship your MCP idea",
      "hash": "ef227ce9e5eb8bbf25c386ad37bd7d37c93dcde5dc02683777ca87bbd3e52548"
    },
    {
      "id": "dad4a37d52a646ce8df08a7736b3a5bdfb92d93d71859e6ebfcef10738fbff8b",
      "text": "so that anyone around the world will be able to use it.",
      "hash": "7af6e527f34b1c529408b25547d474869af528949cbfff9f9e04d7e320dbde1e"
    },
    {
      "id": "588d34db97eb82a0b5fe0e379103214602cbe361057af1bc70df44421ba291b5",
      "text": "Head to",
      "hash": "e09821d2451111ed94d62830c10f7e3e5745dd89da4292656a705beba2730b52"
    },
    {
      "id": "f8c7262475bb7887bb3333c1619d7661218fdd2933531ba495e99ac49c9bb648",
      "text": "AI Hero's GitHub repo",
      "hash": "4e37d6933bf864a8a766476f37384e20e2fe247079b33b72faee09dfab6a189a"
    },
    {
      "id": "f6743d718eefb7a479c59c07607490a57b1b2a4353b1b0ec8376417b002b8fb5",
      "text": "for all the code, and to run the examples.",
      "hash": "a551453bb47a0c30ba090a7721b4060e00396017032f3859ce16952e5c632af4"
    },
    {
      "id": "ccfba805571470101f1cd59bc3eb5d0c1da09bde47642daa1fd94a0b6c09ef44",
      "text": "What you'll learn",
      "hash": "1c1710e31c7cf7c4421ebf663e9209d95ec55b980e98f279320019664bbd157e"
    },
    {
      "id": "e32448af9cb5a01864600f19c8d23def436332a448b8eb3572e6005dd574faee",
      "text": "Why the Model Context Protocol exists",
      "hash": "7c14bdd042762fca52b4ab08be3c97c6c84e2bad8a0e57b43b7065230521bc3e"
    },
    {
      "id": "ec052a8529e5ff73d6038545d4fa9361ddfee735da5d848043e9875ce1fa9533",
      "text": "Choosing an MCP Client",
      "hash": "bd073e0bb9487ebd705cf4dd0f3b1a3b0d75125b339808a01643e964d74d8431"
    },
    {
      "id": "4231bc04ecd54e2e40732e70502d6a9d0c84d7de7a5d3ac52807e40adad5c563",
      "text": "Building MCP Servers in TypeScript",
      "hash": "9aca5551fc70817e30bb279349e2e49183748f8cf6c5fb616853cddf84f600b3"
    },
    {
      "id": "8439469f551eed262e4b3827286542dd6954b721a263dde9eb06bb1295e64ec3",
      "text": "Distributing MCP Servers on NPM",
      "hash": "7ec99f88403971c1c338366f21c8e680d2ee544ebf31514d3392a14084a8cfdb"
    },
    {
      "id": "6c4c8beb37dcd77952b7b14f83cebd1d806606d4f1cf49aac0f94eb4510f0931",
      "text": "Hosting MCP Servers on serverless platforms",
      "hash": "b02f0bfab57e8d6f777751c7e2f87d72d8f5d8d11bb8ecc5df53aa616fb8eca7"
    },
    {
      "id": "bd8c3f594151b09a11f1d547d9a19ca8e938b81324bd2605153cb46960e533e7",
      "text": ", in order",
      "hash": "68cba9003488304327954a8e8befa73118d6753600a5c8ba21d2b99194e0ee1e"
    },
    {
      "id": "05b7d1b0d244679689162e0d14bd0d0c79ad029e6bd4f6092555eb58008e652b",
      "text": "Boost Claude Code with GitHub MCP! Discover how developers can seamlessly modify codebases using this powerful terminal app integration.",
      "hash": "e544ea1b32d1dea7b394284f7490118bd475199f5f14206a9979794ce8f04823"
    },
    {
      "id": "530825fdc8bd3cf5a9ef046ab826f5c8131d683b1f079dd041bbe9b541deb239",
      "text": "Set up an MCP server with a single TypeScript file; connect to Claude Code & run scripts seamlessly.",
      "hash": "fe2d273c78759b015be95f55ee0d5d78a4f29a83776dee3119eb32d46465af82"
    },
    {
      "id": "6037e5c1e050a9f628c0d2b46e30ff416b40d6818cfccfd1a3d5dbd5c09235fd",
      "text": "Lesson",
      "hash": "6e2b26d9de4033b952bd242f69b798420ee887151b937f394efc23252c78af74"
    },
    {
      "id": "0b3f8be89bd066394a84cc2a2c6ac03bf3c8332da0583c1f5f4da880f7b09dea",
      "text": "Unlock MCP server power by using prompt templates. Perfect for enhancing LLM workflows and boosting productivity with custom commands.",
      "hash": "50c53a39b97b5d6795a51e6b5a27ae50386a21a7d2d0fa2dfafd2d2b3e3b6f53"
    },
    {
      "id": "2d210491678b153f159d33c1a82c7d94a99a64ea9ef8e3d6473aeb0528789fe7",
      "text": "Avoid console.log in MCP servers to prevent client issues. Use a custom logger or",
      "hash": "846cb8917066b0de1bdfb3eda583bec3e09dd495261f36ea4dab46764c71b713"
    },
    {
      "id": "bb8865728213f1bda50df6366b6b3c6c6bf16adebf1f356ebbf81ceff4c1baab",
      "text": "transport for effective logging without protocol interference.",
      "hash": "e96e716db5d2381f31503445790ec0d8bfdc7640605b53a742fe4f4dd82c7e50"
    },
    {
      "id": "1dddf682e9b614a68d59354e3beadbff4828bc500c3b7b5a4f64340f6ebe78f4",
      "text": "Discover how to deploy MCP servers statelessly using Redis, enabling compatibility with serverless platforms like Vercel and AWS Lambda.",
      "hash": "c2f7f1578657060a1d4db55203bb7164b05363787b0eb2ab70a8e2833ec834ce"
    },
    {
      "id": "f563b76ef7c553f6af9f6153407fc5d8c346ddb8507ad69806e8d74f695b280b",
      "text": "Easily publish your MCP server to NPM using Node.js. Share updates globally with simple commands. Distribute effortlessly with our step-by-step guide.",
      "hash": "f73a1a773d93f97282a6215742f408aea8cf6aeece99f2766df9e05f51b6f7c8"
    },
    {
      "id": "0c43c0f193b5aa9384204f24e0727da588879d46fa6605312ff04e2927e02c48",
      "text": "After this series",
      "hash": "75f6cb80aa7bdad3183593378875eef704e6283a499b6ff6abbd23b39e102b7e"
    },
    {
      "id": "ed235bdbdccbb3fa7749e4389f4ca0aeb672544ebb59b150444a3f5f39e2a4df",
      "text": "Put it to work with the skills",
      "hash": "afafc559c8d1f99ee7bd9bd45410e1e6f25996b6cdf3f2aa2b79e4a49ed21789"
    },
    {
      "id": "0c39a592e8249512c76a960097aa8384dfbdec9da2b33887c7e31d17f9d97ac3",
      "text": "Free, open-source skills that turn these fundamentals into a real engineering workflow with your agent.",
      "hash": "6fd3244b26a73522c328b991ada3b3cbbcdf48ce9e567250ed819b685d43664e"
    },
    {
      "id": "abb0284072b6717378e15c0cfea43636adc1f4175f80c2d028e1324ec1fbadf9",
      "text": "Browse the skills",
      "hash": "ff3445acb23655f25884c073ab7ed242d2977509db6aad1bf39a651bd4c82db7"
    },
    {
      "id": "69059a1f3d47d7b7fb5876f9631ea5f4fc30f5c66e29450f70e537452aab2287",
      "text": "Learn",
      "hash": "ce78afd0e6a225ecac96a6812b9d192e7eb35889cd5237beb38b50375b79d8dd"
    },
    {
      "id": "bedf0f5b52b77f8e47a277d15f9de76605bdff48aad826df79965ccf1cc44329",
      "text": "AI SDK v6 Crash Course",
      "hash": "71139c58dab0fc6fcc2f49d2d44fd5b7c9e9e6e7fbf043ec2f4b51758b1b82b1"
    },
    {
      "id": "bdf13322f1932d07ec7b756c1e75bde6102ca3fa2ff26f6aa5ef95ccbad4965e",
      "text": "The AI Engineer Roadmap",
      "hash": "0ecca41f97662f50fc4210f00b4d05ed73257d862ecbd642b906cd7da42d4092"
    },
    {
      "id": "8c2f9517d147f6de5b0b55dd8ac7f914b3122dba52347b709db880642b6c91fb",
      "text": "Vercel AI SDK Tutorial",
      "hash": "2f2904108d573c969e5838280a3b2a087d103fdf0b462b1707035a6d6da2d62c"
    },
    {
      "id": "bc0dbfcd4c069fe6bda3a62c0346d00e8ff5806f87515d30ebe547361b3ddd32",
      "text": "Cohorts",
      "hash": "e777d5967e8cd7d5430cf77dddcd2c67e54c6cdd955e18f1b7923733d09bff49"
    },
    {
      "id": "7805c6100d902c74d3834b71a8f4e292b425c62c9f872101da01cd7be4a27ca0",
      "text": "AI Coding for Real Engineers",
      "hash": "bfb5e9a9585215411729c3299f3518ae3dc543e956c197946e16be2ec2bc1d1e"
    },
    {
