    {
      "id": "244403cbcf9ac7f32acfaf6bd47e5e8e79e7e03a9462fe921ad959618fc7f478",
      "text": "Free",
      "hash": "f411a1fb62758b4c54690d0a702b4955b54dd22115416fa7b1ce51b4a084818d"
