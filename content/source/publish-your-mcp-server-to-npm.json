    },
    {
      "id": "8454f8bd9e10d32ec779cd1dcc045c84c17f0600e067041a4c08a4af1c5b8494",
      "text": "TypeScript",
      "hash": "ed0504f70a48ffe9ed17e7ddee02a72a9c8af602aee1f7ce11853975ce911733"
    },
    {
      "id": "84aad6f4eb3a21c0ebc6ced036a57a8e91ca649edcd3c2daf3f85fe0e3836c17",
      "text": "Publishing Our Package",
      "hash": "6e6588d29496d880d61ef94b6a2836d446cd81f77e617373056e5e9b9ebe193b"
    },
    {
