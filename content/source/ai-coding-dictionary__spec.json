    {
      "id": "823ff058a27adf14fbe4a90cc11fb75bb7c50a192cd84dad345304ad7bf26f2b",
      "text": "AI Coding for Real Engineers",
      "hash": "bfb5e9a9585215411729c3299f3518ae3dc543e956c197946e16be2ec2bc1d1e"
    },
    {
      "id": "12ba6a8098d7fc3ac9421b6ca7e7b49fb092e92a92a39e864c0f4610b9bd396d",
