      "hash": "9c7b53e3d0e1538c590ba330024e61d97b981d48f8beb40791c5867170d2ae49"
    },
    {
      "id": "14aeb23ad6efa142066bcc919180d48a490c836ce5e7d875c8d0bf929d284d88",
      "text": "Finish a merge or rebase conflict, hunk by hunk.",
      "hash": "f0a2531ad701741352b3d7c996df8522dfae50698ebeff40d771a35d0f768fec"
    },
    {
      "id": "bd5664735b5b587c496f2e68e4d32d41c22b72c6a0b24bd33044aa7c4d878f8f",
      "text": "Matt Pocock",
      "hash": "2fe2c13509fbd45ec2578a74ef8efda313caad4f19533a102ca7d666ed60881d"
    },
    {
      "id": "81ead9cc05f2a6690edef92e4b85fb3a374cc229205e2ac18b1e1ad3e5b9a572",
      "text": "Subscribe",
      "hash": "cc0e38da9c41790bffef1b88af32d39ac285edce93da766810edc237cb2f1625"
    },
    {
