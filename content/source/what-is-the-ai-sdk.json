    {
      "id": "1584d5ee4343b1d360ed1aa52b1c53cead69274d594de745ab4657c44f4bd042",
      "text": "01 / 16",
      "hash": "404ff6d289af96c810004255f494b66ea2ab726b747a74f62395fcebe0835330"
    },
    {
      "id": "e96c1649784931019fdf4a59e76b760c632054b3219eacb31e361201c610ea84",
      "text": "Learn how Vercel's AI SDK simplifies building AI apps by providing a unified API to interact with different LLM providers.",
      "hash": "70e6e8518148d88f9eb2e6b9ac70893230032a65cd91855520e7468531b8680d"
    },
    {
