    },
    {
      "id": "9fff9abaf89269230446ef60f253f5580369c4fa70045f143964e1bc0c8f292f",
      "text": "AI Engineer Roadmap",
      "hash": "29a768799acab15b5a0ee28f241b6e057d0b5ff706c70c3edf7f24676f3d77a8"
    },
    {
      "id": "dd18cbce3de31eb9ba18400fc4eb238c519fe8d5fc0fecb261cf7eaf0565f465",
      "text": "AI Coding Dictionary",
      "hash": "4def77f9388809f53620144510fcc4b6f08662617bcc06a15abc618242e6544c"
    },
    {
      "id": "4812396bc808dd51f7c727dd78ba5ecb86301fba2077dc28009cd5d32ac208d0",
      "text": "Topics",
      "hash": "e22820fcf5cd90e3fdd99a7569e0ee2f30eb7ebadfb2fe4d159b30c166ff81b7"
    },
    {
      "id": "1a48955ab98769a0067e8dbf3ef638eedff0597cfe4d7fae6a434e5cf1499445",
      "text": "Sessions, Context Windows & Turns",
      "hash": "6ba86329848f193a00922dde232ac1e483d8805be061a48f5580560ee54d0b69"
    },
    {
      "id": "7bf4b39786a005772bfa94935f4774d788763903ca5a77d78488e24f5ab2b6e3",
      "text": "Session",
      "hash": "6959b4159575d8dd76d9f3bbe2c6437904f861e7860c35abd18deffb1c3425a0"
    },
    {
      "id": "d9559ee1bd0ceaf19cecefc5c8213ab2d6617a0ef16d09dbce04a000552fb6d9",
      "text": "One bounded run of interaction with an agent. Starts empty, accumulates, ends when cleared, closed, or compacted into a fresh session.",
      "hash": "7ee077c28b8cf80eddb60651b9dab5945078732aa6f084cd7ff75ea753a2068d"
    },
    {
      "id": "3c5da0dfa8c78ea7bffa38e86261f8c4fb308fb8740351347b758cd3d296f4bf",
      "text": "Matt Pocock",
      "hash": "2fe2c13509fbd45ec2578a74ef8efda313caad4f19533a102ca7d666ed60881d"
    },
    {
      "id": "e2f5dd16c7b3869b26ac8127552e54ce95eb66c7fe30785106b55d07d6896526",
      "text": "Copy page",
      "hash": "4104018941ae3ab016c117887a91b4f933f28e36c587b8983373fe9377ce34d7"
    },
    {
      "id": "26e1a047ef394d8da500e71dd07fcea39733ba21f8a969e0e712df283fd541aa",
      "text": "One bounded run of interaction with an",
      "hash": "57ecebdf972973ff885211f7efe4682a92275c9ade4f78a80cca8827f5e46565"
    },
    {
      "id": "8b8914343df9c849146760345ae2ec15fd6d184710b02b3393f9424c012b5ecc",
      "text": ". Starts empty, accumulates messages,",
      "hash": "3b35148c0db762fc8410eb32b69fd9f5cd1c994cf4b8fff3ff232bcecca80c21"
    },
    {
      "id": "911e341529741282cd72e23f9192338d88fcf10ba9572508a5326ff9cab383c9",
      "text": "tool results",
      "hash": "a5594e12dfffd8e54c36d9b99bc31c7d41f0389d2251790338f34e836a3211fe"
    },
    {
      "id": "7ab3b86476c7a9b2e43563089605d6bf6930b2f9fea9582e40b453cca1bdd1cd",
      "text": ", and files read, and ends when",
      "hash": "11857375d8e558486e7fd1f991301832693af933a043f28e21cd253feb7cfb14"
    },
    {
      "id": "e3538f6360d58bcb4ed4d8999d084f479adeb5848472a95c3bdfe4c182d4064f",
      "text": ", closed, or",
      "hash": "f1c78c52949799b19138849b1e5a5424687772eadafa19552fc8a8a65b02ae50"
    },
    {
      "id": "819d7ddb150557667540f9ebf5514ebb409c1152c6505980e105d79bee69c62c",
      "text": "into a fresh session. The session is what",
      "hash": "a567b71dd817a1453137c3f7c917f6405870ac2fc6438619695623771df2c4d9"
    },
    {
      "id": "c82ae66d49782a6376d280df8d8291fe1eaf88b2203bd5e6c0462f8c3cc73935",
      "text": "context window",
      "hash": "6764434518d37f01df452fe2af0af3f314f8c27a72519001ea14189c5ee42476"
    },
    {
      "id": "2d9c902585a02560c9d5a2ac4d78bb0f1dbb0021ba73a62e88c66e9d682f2a01",
      "text": ": if the context window is the box, the session is the stuff slowly filling it up. Work too large for a single context window must be split across sessions.",
      "hash": "1c3a2ba777e680212b2887adc29467be51bf429e9a0f0699187bb1ba5e66d0b5"
    },
    {
      "id": "c8cb69ab109711580adf80c1da143ecaa2cddca1db2a57c0b80a3a89ce72ffbd",
      "text": "The session's message history is the agent's working memory. The",
      "hash": "3966ce97bd7afaa0d0e5b9b9b97faa5521be17b84be8fbdc32cc11f0d5a7c0f4"
    },
    {
      "id": "477748e70f6c6a6a39e8a109ead3a01154f82264b594fccbe10fe12af97470bd",
      "text": ", so everything it appears to remember — what you asked for, what the tests said, what it decided three turns ago — is in the message history, re-sent with every",
      "hash": "0a0fe7b131172a8940bc219780b5b36a45f2e6a5974044da2b48057ae3af59aa"
    },
    {
      "id": "950a9e4e54e0543f3380bd1d68b681d527c23f18ab7c338f44f6501348a70cfa",
      "text": "model provider request",
      "hash": "3004d539f1f0ae7a40070d95ba4a1323d874684827edf4d55b29a1056f8da7a9"
    },
    {
      "id": "6282f9b3bbdc0bf9154d9e8a58eeea049a550b2bbe7eb17fc713320507789512",
      "text": ". Whatever isn't in the session doesn't exist for the agent.",
      "hash": "7a6b54f52ac5925f67f905013022d9e5ea5a5b69e19e2fff61fabf5aedca54f6"
    },
    {
      "id": "76dcace64285cd07bcd9d4330d71c32170ef053d5658b2c61ce2911c4da67da8",
      "text": "That memory ends with the session. A new session starts from nothing: the agent that knew your codebase well at the end of yesterday's session knows none of it this morning. What survives is the",
      "hash": "841bec8db8130abeea33b6677a76ad63fbc22de465deae71d3aa9ad121dc53b8"
    },
    {
      "id": "f9594dfb6af154df7d823e371a548d691e987839c5ae37f67b852a9a7afa88e8",
      "text": "— files written during one session can be read by the next, which is what",
      "hash": "9a31648e82ffe03bf24c20370bbd2f90225ee0815244c62cde3367c0976da0da"
    },
    {
      "id": "7b2c20fdacf9f42f80602815c84a6f229a2ca427984feab91c266d7aada16554",
      "text": "memory systems",
      "hash": "8699aeec0f58f0cf15c1e661971b31bf6a9663656c19f558ef1a1450599d15ce"
    },
    {
      "id": "e7848d20e977e851c2613ed26625ecd1269b9734bfb9af95c96ffc4e82070676",
      "text": ", and",
      "hash": "4aa9bfd2f175a94ad5a7cb321e1aea9790c73eb366a3415b47a00aeaa9fbf24a"
    },
    {
      "id": "6f9551bc9ad2bfdb9cb89e74b62f32a6ad7f78dab482d7f078456f72b627f5a1",
      "text": "rely on.",
      "hash": "a22c24bf01bc42be345625ed23817afac1fd91812a6a802b09bb8f6430801472"
    },
    {
      "id": "5679e0604b997b8011254a313bf60e5c978255d53076efb5b95491f56fa9a593",
      "text": "You choose where a session ends. Everything in a session influences every later",
      "hash": "efa28b2b0969e0eef07f7be2af29be12ed7494c0d14627d9a32f368116bf3d58"
    },
    {
      "id": "d09c52ad8e45f2522bf2aa063d0e21e3d837fb10f8d95370ab8770eec4f1f6fc",
      "text": ", so unrelated tasks done in one session leave residue that colours the next answer. One task per session keeps the context relevant; finishing a task is a natural point to clear.",
      "hash": "b2ffd57cc3f4b08abde9ad93387666656a228950c2e54d7a89be8d8700f419bb"
    },
    {
      "id": "e62d31ff1379efefdc1228b1204a54009eb8ce5ce2f38d69058bdb7cfeb92821",
      "text": "Usage:",
      "hash": "2bad3eeaf33caffe3bc9b482b4934ed19eb4ec3614c12373e1a5c5f8948217da"
    },
    {
      "id": "319b52386cd28871e7db16410fe59c192fdb8b17af0f2656c4d177af36fd831f",
      "text": "\"How long can one session run before it falls apart?\"",
      "hash": "3c4f0b397a30218bb94e037590cb85d1272c21fb9b0ef6a2bc54e6b252e5ac86"
    },
    {
      "id": "edabcab680a3efa2afb5cae5d9840ca88096aa940a3908e64b7032f10ad39f77",
      "text": "\"Depends on the work — a focused refactor stays sharp longer than open-ended research. Once the session bloats, hand off or compact, don't push through.\"",
      "hash": "57126440f74246cef9ee662a73311ae3caad1806c698887f63164f3d2c6e7d68"
    },
    {
      "id": "8c5731f18bc5eee4e899827f045d9a1d20bd2ea08d3d60c37b08fd0a21203ede",
      "text": "Previous term",
      "hash": "735604aff9e8f2192b83df4905cfc8e395613e0ce05f8ca85a1d2d1d44fd59f3"
    },
    {
      "id": "e7f2f04c7fdbc7a2a8beb6da16fe2357e6f1ccae00ce26fcccdfcb3056394c43",
      "text": "System prompt",
      "hash": "561257c019e5e351b341fcb53a45a61e2748698f14404bd38a3dbe58a957ec30"
    },
    {
      "id": "71a0b72ed606a2f81482586f1be3f06ef517d09a086f1f255b8a58f7af0cc329",
      "text": "Next term",
      "hash": "5219c7ebdc0e098aa6db6f09e405c1b17ab75f1082862906a872e10a16818f9e"
    },
    {
      "id": "2076e3fe796b80402b4ab99d53f7ef2dbbafe9ee9c29b11c956c3f2fe616c1fd",
      "text": "Turn",
      "hash": "b823d5f9d1ce690c00935e097200405bcf903b6bbd61e4866c3c1fda7fb3238c"
    },
    {
      "id": "4bdd386926d6eff6e26c5afb7fb140bf1df5b59f8adaa2f8c8736075a8fde6cb",
      "text": "Want more than vocabulary?",
      "hash": "5d5500a083006a1606e84a03c018904d01364631c6baea4c7a3f8f3f62bf94dc"
    },
    {
      "id": "ea3d28a6744c470dfc6497ceb8cc119ca3a5d3e397a159cb7f3bf9ddac8a1b73",
      "text": "Join AI Hero for practical skills, thinking on AI engineering, and resources that keep you ahead of the curve.",
      "hash": "a082f7147e30da6afe92268d5668a530edfff13e64934f8f63f22c098db86133"
    },
    {
      "id": "bc3471d9904361ea1039b4699fbb244915ef0ad16e88727f5b8244f25b36b0a4",
      "text": "First Name",
      "hash": "96ce6e6193a047260f5c32aa416d88b6e8959111f43f98457af9cc009a0907ad"
    },
    {
      "id": "168d72c4e346c4112805ea2b0d0e96f6d1176a2dad8a32aa48543add12bd9f44",
      "text": "Email*",
      "hash": "61dff02026341a6e553a56fc2ba214a76ad68c18cc67bf732993cfdbd51bb8b4"
    },
    {
      "id": "12a1174e157d736e695977cc8336e8ca1795d56dc55129e2818f559a75c04aa8",
      "text": "Get AI Hero updates",
      "hash": "81b46eab414c141d6dcd85a5bd534179bf54a3532469436d693c437e9de3a90a"
    },
    {
      "id": "788825e350dab27c37f73d7c5bc9118b1424e32cbdb9da80f2da2b7f36b747ce",
      "text": "No spam. Unsubscribe anytime.",
      "hash": "461f8758206b36fd4ddfaf6740b33dc0de41c9c7acb9121525993b781d5e18bb"
    },
    {
      "id": "0e4875850ba2ce6b88635ef391319d8683d536ffc0de62a5db8dfcfe57e12c56",
