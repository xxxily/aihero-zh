      "hash": "e22820fcf5cd90e3fdd99a7569e0ee2f30eb7ebadfb2fe4d159b30c166ff81b7"
    },
    {
      "id": "e428d7abf6527f8cf85604c6d8599891bc34b507ae2aedbf0163d08567898bf7",
      "text": "Essential AI Coding Feedback Loops For TypeScript Projects",
      "hash": "606584f682a76facf52e9e7bbb00b984668114bddf50a0f12d7ad046133e8c44"
    },
    {
      "id": "a48798edcb1b2b52e5b10bc1f1079c6b46cfde4532c0ce5459d30d9d738dcd4e",
      "text": "Learn to build AI coding feedback loops with TypeScript. Master type checking, testing, and pre-commit hooks to keep AI agents working correctly.",
      "hash": "7456594e56b790fb4dfd7710a5db5e5e4883aa4e6e6b4326f98de717178c63cc"
    },
    {
      "id": "8df246bed3e2584bec81d3ccb74879f861bf632ef8f8646e7114f5a6fabd1958",
      "text": "Matt Pocock",
      "hash": "2fe2c13509fbd45ec2578a74ef8efda313caad4f19533a102ca7d666ed60881d"
    },
    {
      "id": "1743963221837807840d1145bed1b783d51cc7464e8be122bd5634d8d028fdfa",
      "text": "Subscribe",
      "hash": "cc0e38da9c41790bffef1b88af32d39ac285edce93da766810edc237cb2f1625"
    },
    {
      "id": "dbaaf716dfa767d8b1b0f2e2146f2d742af2911f0b8600e9783e4d17efa2cbfc",
      "text": "Source Code",
      "hash": "bc47da663d101bfc1d4edcb3762f37fbe8fab3e931cfd460c69cb432b806d419"
    },
    {
      "id": "e47931a6181764a968b71c601c29b699b47acf2fe8bca3708fe3750d62d984ed",
      "text": "Copy page",
      "hash": "4104018941ae3ab016c117887a91b4f933f28e36c587b8983373fe9377ce34d7"
    },
    {
      "id": "755096cafa764bd1f67b2284bf017517f4067f743faec7312ea8af816c1e382e",
      "text": "Share",
      "hash": "29887a5ff9846ccc23327565a07e17fa6dcaea6211f1898ae825f84ae38f4223"
    },
    {
      "id": "9c6851b6175e2772e6022097cd327c583bc40357bc3fd312781939857253930c",
      "text": "On this page",
      "hash": "b5658fc8edda24f9c94eabac9e536e0a18e3055a8ca255f9d1b8f256ea02a6cc"
    },
    {
      "id": "efc16292ceeccd67ae6e9d33517747941b01a1917d7e04597c46473a5a8882f9",
      "text": "Set Up TypeScript and Type Checking",
      "hash": "de2d872aa3c73fe84c461e0c6a077ca207ac12572cdbf4c4e4cdd752b2648eb6"
    },
    {
      "id": "cea10633efe2785fb70148ad1aea672f9e2d40e7d828d1182abf182b0c890d24",
      "text": "Add Automated Tests",
      "hash": "e627b5697121d4be961e7fbfdf3a4131570c3224a0a0afc6adae4eb671a014ad"
    },
    {
      "id": "6f0cf303cce9cb60a68e672c526728ee931ffa4bfbd941f9655e83d33198e6ed",
      "text": "Install Husky for Pre-commit Hooks",
      "hash": "2b61e37b6f9fb5330ef97c758a73c500bb39c67d6d67ac5054a94f4613353ed1"
    },
    {
      "id": "32e32ae0609da00fe6c2b135e0fcc3f618e98081d26933591b6ec34eb07e3dea",
      "text": "Set Up Automatic Code Formatting",
      "hash": "72edb946a267aa1d1030be91c643c1b28a1ac5eaee12df44b8cfa47381dec740"
    },
    {
      "id": "f12b0a992e4c56c7aa2d349915007c1053f3c7d03ffaa4f2e983cc3cded11741",
      "text": "Why This Works for AI",
      "hash": "78bdb8566bb7a8c9a231db392d43e0c4173146a6157dba3b4b64ea5a4369d784"
    },
    {
      "id": "267d58327ceb3091f82009595a9c934963263f1df048381af788533da1059f8c",
      "text": "Related reading",
      "hash": "89c21c36ad5ffbab7b05ced367c46013c8d7b8ddf53a8b9739b7b2545f78abee"
    },
    {
      "id": "2d50b186d428107bd99d58051b8c93d2d6862658a08510b102089b3ae74d2ecd",
      "text": "When working with AI coding agents, especially those operating independently, you need feedback loops so the AI can verify its own work. Feedback loops are especially important when you're doing",
      "hash": "f456b3420a72e9339ee87f6a0497af2d2825dfd83bc1807ff4b8587ae5325939"
    },
    {
      "id": "e36e4d6c8e5ed6dee458bf8058a1afe8a66c4f79fa5c5d7dfc99af26c5457152",
      "text": "AFK",
      "hash": "875e0577157f743e3346ba95f1d944d08e54b3cab40d89819dff5f48cd507392"
    },
    {
      "id": "1fce79a49783e252ca5bce1461699b4d2200192ab8a3843f0fb428e5636cd648",
      "text": "coding, such as with",
      "hash": "8d9b1c7e3a7ab16ca05e8f00a871e8e6fb50bce101e105795410e6e08e4e6799"
    },
    {
      "id": "fd1182ea5b9d6a373938c50980f49a705e3c31c66534448a5a4334213b0b18a0",
      "text": "Ralph Wiggum",
      "hash": "2c1f10d7df07c1399420e89ef823af3cc7f34cda5b8306c06e09f7e412e52b12"
    },
    {
      "id": "9175c85478a6607848edf39da4f3edb0325318bc7cb657e94bf5d3a4b73e571a",
      "text": "1. Set Up TypeScript and Type Checking",
      "hash": "a89e44a5ba3914d56eeba79afafc190f9a72dd2de7a4e7f262265a8bc6b952ab"
    },
    {
      "id": "d50fd64d33491482b48db5a1ae1b05b72665d4e975c2816bd733242a585ec307",
      "text": "TypeScript",
      "hash": "ed0504f70a48ffe9ed17e7ddee02a72a9c8af602aee1f7ce11853975ce911733"
    },
    {
      "id": "7246efa1ac848627f06f909a1c1883c7802b1eb569a25174fe103c11425451ac",
      "text": "is essentially free feedback for your AI. Use it over JavaScript.",
      "hash": "5494ecd14fcf254f319d8fd1a2d85353b4f8ad300571ad77cb3dc244d37a923e"
    },
    {
      "id": "4910bff1ab1163ce36a22331ecbb44a277d0eaef293df40bbdc5cc5997c8ffb0",
      "text": "Create a",
      "hash": "a2a769e959cfd33c6744a4099fd4d901e8e2814f5dce4ca3f330aece5991d1ef"
    },
    {
      "id": "8e27c3c9d1775606b024d6347a14491ba7c35ca7cf2b1a4c0a51fe9bdbc29405",
      "text": "script in your",
      "hash": "d29f226fa91ec21bf01ca9c8fdd13739ce01d9d66b695d8b5100e6961bbc99a8"
    },
    {
      "id": "3d74143c5c753e1807d75db2dc8faeb0cf57cb1bc9ea644dd51e99070bc6b13d",
      "text": "TypeScript catches errors the AI would never find without testing in a browser.",
      "hash": "42dd3fca4c70016a24c0a5af5eb7fe5e01d8ff1d0f8e5f66217132dc40330173"
    },
    {
      "id": "a2cfa14d0dc104034cc0d1332f99808f52592ba2cf7f53190c0328a883eb8d6e",
      "text": "Go deeper:",
      "hash": "15ad3d88c6733d9b257c322d3afecc9bce2b18558171007db87598c118ca17f9"
    },
    {
      "id": "c764fa928b6027dcba0bbc1c76b5f71af0fc25c3f9ac3b689f54b1a921a77be2",
      "text": "join the waitlist for AI Coding for Real Engineers",
      "hash": "16c3492a8464a0859c944e287a9d433e9a2635f22a6bd8aad59f88c3e80ab732"
    },
    {
      "id": "95a02265bd421509c34c5fe28233bd84d0870d9a08cbada8cbfabf088431be4f",
      "text": "2. Add Automated Tests",
      "hash": "49aa76b46512eeaa8271bffd4cb9aeccaced7f07273c5732450e81ebe6bbf202"
    },
    {
      "id": "4e7854b3f1ed948d1bfb3426e56bfefa0b0bcc1efddc985bde874e964d3f59ac",
      "text": "Use a test framework like",
      "hash": "93fd24107fcf6ad8259861249a62f29fb236fc08c83b3cf6d3f19f3db9917204"
    },
    {
      "id": "93e8f8cae62ce3760729a323158a893d711856e9e7ea716fec42323ad379f98d",
      "text": "Vitest",
      "hash": "7fc39eb9c7e0008f216f56c52cfd70cadbfd8ec27d051a8af9dc6f5a8a23e293"
    },
    {
      "id": "dd5055652155fdea5701e019e21a724aead830fe235fa644341d5789ebb1d496",
      "text": "for logical errors:",
      "hash": "6003665a6b0958b7096858e939268c81b6e7dd6aa3331a6f587bfb334e5584ef"
    },
    {
      "id": "ed6556f6bea5518879b5f9159a390000ecee25ce21a3c90c319763f46f1b3379",
      "text": "Basic unit tests covering core functionality help keep the AI on track.",
      "hash": "2e797ca990b57bc57e6c733e96ce2a0116a0a5ff9b86b5463ecdb517835957fd"
    },
    {
      "id": "0a45402904b3c3841c63bb870061b5cbc628ecf3e435d1e11b44f0bfc8d3f604",
      "text": "3. Install Husky for Pre-commit Hooks",
      "hash": "d9ea2b5f11de4052308a6fe02d1f2f1907eccc569443115ae789362c43472223"
    },
    {
      "id": "766dd0ab63752e3dbaa0e99aee3c85d5f78e347fff1593a813045a27dd456faf",
      "text": "Husky",
      "hash": "1e10763c1b9444d4dea602f6347dbf4e24d5331e1ba97e2932c5dd87bf6c4916"
    },
    {
      "id": "22a172d4b9d8ec974205f2f464b8f7899ddb6540543beeba087057a0ca889f88",
      "text": "enforces feedback loops before every commit.",
      "hash": "8c690ab557a3ed1a8518ceea3cc173902470c862131dfdc4277d2a824cc27a77"
    },
    {
      "id": "658b3d8df8ce2e4d4613d6fed57a4b88ef2160f2f0ec00a91d7f725e598e0c37",
      "text": "Install and initialize Husky:",
      "hash": "34fff9bf29fb71c3a9eca3aec75140fd423ecd730f0b65672bff8d59d8a019ff"
    },
    {
      "id": "01db269dcea18098d39e00bdbfc27cf04c1c881f4a95ba95bd9d68b3f9e0d036",
      "text": "file that runs all your checks:",
      "hash": "9780560164191f9485274de695d5ccc494ff147f58d1ae2396beb1f3d62014f7"
    },
    {
      "id": "15bf6067bd2526ce4f06e5269cbb978aad3cabea6b2cd38d3e419bea38e43681",
      "text": "If any step fails, the commit is blocked and the AI gets an error message.",
      "hash": "6cae7231cfd271ec2504d2a2abccb538e091d8bbb62d9d64812d9ca6260d4b69"
    },
    {
      "id": "fb097357aeb593f48a4b204abd41424b73d728a22b4ddb974a23534f505cc290",
      "text": "Another powerful feedback loop is making sure the LLM can access your running dev server locally to check your frontend.",
      "hash": "ace1208227c6e43f7976d7219029c6ee39d2db77e295451c29050299b574d59e"
    },
    {
      "id": "e5cd9485060c1f5c57ac56b9bfc9336569266fba1922f48f2198ba69c21dd406",
      "text": "See this video",
      "hash": "70703ea6533f78f480fd65489262c25fe609334beff8b5f813a343d1f2b52877"
    },
    {
      "id": "5561a4353c7c4835f26fa64090d1b400705aa27db40e5d6219533422f417327d",
      "text": "for how to set that up.",
      "hash": "5e1c8170e81294c214569ffe8a9583cf9759645677a77ef39709f22aeae37cf5"
    },
    {
      "id": "6630980fcfe1f651eef559f8ec839a874fdcd6dd9e1bb0adcfd145ed14d7f9b9",
      "text": "4. Set Up Automatic Code Formatting",
      "hash": "3ed1d8f66150b38f7120172216e37001f65c1b577a33ec4985ea7388817a0719"
    },
    {
      "id": "0ca45e57af795f1273e43223b1d5f835b29c6959e3ed2d1a152c0f9ad49465b5",
      "text": "Use",
      "hash": "c36d819e7bc6d2b7da51394411c733db89c395987885ca6770167a3b9bc45c3c"
    },
    {
      "id": "74137b24393c6da1fb70da8b0f51cb00a90c5e1d552c6dde621b613b686604f9",
      "text": "Prettier",
      "hash": "61dfdd7a227f42f2e09d8ba79aece31f0d8127e6e72f1c6182aeb9fdd7688a90"
    },
    {
      "id": "f6b6bebd8c4095b914ab458dd3353b805b2a7902915e3550811a063e9d11ead9",
      "text": "to auto-format code before commits.",
      "hash": "589822b3b9c6aee30377673571e96f63e9d732df19f0a9b6f36cc7c0f14b4199"
    },
    {
      "id": "4d0c635a14b857332003ebd5699d67c0a83fab0254e982b34ff2075189ac506e",
      "text": "Install lint-staged:",
      "hash": "77fe559cfb2a98a0ba5bcc4d4a7eb32a49569d08781232cb35cf0c42b74b62ce"
    },
    {
      "id": "6cdc65a86abec687319915b30d794875a026c732496d9f72961ca916b7f08ea3",
      "text": "Configure",
      "hash": "6defafa2caa65304173956e3fbc26b6947c50bc769c08c3da32c1032fa6519d4"
    },
    {
      "id": "6f56ac970c0ccb293f5134a926ac5ec0704ca1027bbfdfb771013279a4369b3e",
      "text": "This runs Prettier on all staged files and automatically restages them. All AI-generated code now conforms to your formatting standards.",
      "hash": "82e1ef8ca2a350b0d622688baa35bb79399edb6a073a723f76e9e7d6f4913ac4"
    },
    {
      "id": "20b49309c744634d95e8b0eddfaa766be27033ffbc64d8bcf47f7a7c968857ce",
      "text": "We could also run",
      "hash": "0bc5dcbe2915df6743040284240c78eaac9ed15fe677d7bd30b5675a3b0ef961"
    },
    {
      "id": "53136420cdfb35192b574576840edf45c4b4a3d9c16be6237cd789b3077554f2",
      "text": "ESLint",
      "hash": "6e3a6f9e9947021031d8864ca2758613f8589ccdfe59c93fcf8a0330b92b2521"
    },
    {
      "id": "8c0788cdfb4850b008a8f84ce9e49f3339d606b1be0272053b504d9fad5317ab",
      "text": "here since it works nicely with lint-staged.",
      "hash": "0c3dba174e55c68af8954df098dc604e74d9378f6b26c35e7a9f223ad33d957a"
    },
    {
      "id": "d63fc469cff389aaaa132ad566ea97dcde6c97dff2fc82bd80436f4306a904ca",
      "text": "AI agents don't get frustrated by repetition. When code fails type checking or tests, the agent simply tries again. This makes feedback loops (and pre-commit hooks, especially) incredibly powerful for AI-driven development.",
      "hash": "ff21da8e176ad27078c60c9ea5a8ade51565d1ef622b07120b634f9444e2d886"
    },
    {
      "id": "46a904d8b833b749583de19ab885cff8aa2eae23b46a9b77592036f14ccc4493",
      "text": "Share on X",
      "hash": "78d21bbf6b047944ec42890d28e151c61dbab35213fc65cc7be70c0c19c24407"
    },
    {
      "id": "5b2596faad6044245426f1fb352d358b1a4e62536ddf8d970d1db7ca2db87897",
      "text": "Share on Bluesky",
      "hash": "08863b88a05c60410c38c4caec5bc72535b0f01793ce6cee9171b6358b2c11da"
    },
    {
      "id": "ffe5c383e597f8b9a6fdd750b087e190b6c8a662503fa74f1de5ccc4f0d8f41c",
      "text": "Share on LinkedIn",
      "hash": "ab87c050148bd1d372e3ec3483a606127a7a1faec0f1ca5543bc3465d84fe6c9"
    },
    {
