AIHERO_ORIGIN=https://www.aihero.dev
AIHERO_ZH_REPOSITORY=https://github.com/xxxily/aihero-zh
# 本地保持 127.0.0.1；容器、VPS 与云平台通常设置为 0.0.0.0
AIHERO_ZH_HOST=127.0.0.1
AIHERO_ZH_PORT=4173
AIHERO_ALLOW_ORIGIN_POST=1
# snapshot = 只使用已提交的固定页面快照；其他值会在 TTL 后刷新上游
AIHERO_PAGE_MODE=snapshot
AIHERO_CACHE_TTL_SECONDS=86400
AIHERO_HYDRATION_DELAY_MS=3000
AIHERO_TRANSLATION_CONFIG=config/translation.json
OPENAI_API_KEY=
